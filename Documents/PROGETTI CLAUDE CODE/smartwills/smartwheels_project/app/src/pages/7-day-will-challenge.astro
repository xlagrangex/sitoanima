---
import Base from '../layouts/Base.astro';
import SectionTag from '../components/ui/SectionTag.astro';
import Button from '../components/ui/Button.astro';
import { EMAIL } from '../lib/site';

const days = [
  ['Why you need a UAE will', 'What actually happens without one — accounts, the default formula, guardianship. The calm facts, with sources.'],
  ['The four decisions', 'Every will comes down to four decisions: beneficiaries, executor, guardians, specific gifts. We map them one by one.'],
  ['Beneficiaries and percentages', 'Who receives what, why percentages beat lists, and the "what if" scenarios most people never think of.'],
  ['Executors and guardians', 'How to choose them, how to tell them, and the backups you should always name.'],
  ['Choosing your registry', 'DIFC, ADJD or Dubai Courts — the honest comparison, with the public government fees.'],
  ['Translation, submission, the video call', 'The technical steps made simple: certified translation, the portal, and the short call with the notary.'],
  ['Keeping it up to date', 'When a will needs updating, what never requires a new one, and your annual review checklist.'],
];
---

<Base
  title="The 7-Day Will Challenge — Free Email Course"
  description="One email a day for 7 days: understand your UAE will — the decisions, the registries, the process — in plain English. Free, no obligation."
>
  <section class="relative overflow-hidden py-20 md:py-28">
    <div class="pointer-events-none absolute -top-40 -right-20 size-[30rem] rounded-full bg-gold/15 blur-3xl"></div>
    <div class="wrap grid items-center gap-14 lg:grid-cols-2">
      <div>
        <div data-reveal><SectionTag label="Free email course" /></div>
        <h1 data-split class="mt-6 font-heading text-[2.7rem] leading-[1.06] font-medium text-ink sm:text-6xl">
          The 7-Day <em class="not-italic font-semibold text-gold">Will Challenge</em>
        </h1>
        <p data-reveal class="mt-6 max-w-lg text-lg leading-relaxed text-ink-soft">
          One email a day, one pillar a day. Seven days from now you will
          understand exactly what your UAE will needs — whether you do it
          yourself or have someone handle it for you.
        </p>
        <ul data-reveal data-delay="0.1" class="mt-7 space-y-2.5">
          <li class="flex items-center gap-2.5 text-[0.95rem] text-ink">
            <svg class="text-gold-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Free — 7 emails, one per day
          </li>
          <li class="flex items-center gap-2.5 text-[0.95rem] text-ink">
            <svg class="text-gold-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Plain English, zero legal jargon
          </li>
          <li class="flex items-center gap-2.5 text-[0.95rem] text-ink">
            <svg class="text-gold-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Genuinely useful even if you never buy anything
          </li>
        </ul>
      </div>
      <div data-reveal="right" data-delay="0.1" data-parallax-scope>
        <div data-mask="tr" class="petal-tr overflow-hidden">
          <img src="/images/challenge-laptop.jpg" alt="The 7-Day Will Challenge emails on a laptop" class="aspect-[4/3.2] w-full scale-105 object-cover" data-parallax="5" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Days -->
  <section class="bg-cream-deep/60 py-20 md:py-28">
    <div class="wrap">
      <div class="max-w-2xl">
        <div data-reveal><SectionTag label="The curriculum" /></div>
        <h2 data-split class="mt-6 font-heading text-4xl leading-[1.08] font-medium text-ink sm:text-5xl">
          Seven days, <em class="not-italic font-semibold text-gold">seven pillars</em>
        </h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {
          days.map(([title, body], i) => (
            <div data-reveal={i % 2 ? 'right' : 'left'} data-delay={String((i % 2) * 0.07)} class={`card flex gap-6 p-7 ${['petal-tl-sm', 'petal-tr-sm', 'petal-bl-sm', 'petal-br-sm'][i % 4]}`}>
              <span class="font-heading text-[2.2rem] leading-none font-semibold text-gold">0{i + 1}</span>
              <div>
                <h3 class="font-heading text-[1.3rem] font-semibold text-ink">{title}</h3>
                <p class="mt-1.5 text-[0.92rem] leading-relaxed text-ink-soft">{body}</p>
              </div>
            </div>
          ))
        }
        <div data-reveal class="card flex items-center justify-center gap-4 border-dashed p-7 text-center">
          <p class="max-w-[16rem] font-heading text-xl leading-snug text-ink-soft">
            Day 7 ends with a complete checklist — yours to keep, whatever you decide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Opt-in -->
  <section class="py-20 md:py-28">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2">
      <div>
        <div data-reveal><SectionTag label="Start the challenge" /></div>
        <h2 data-split class="mt-6 font-heading text-4xl leading-[1.08] font-medium text-ink sm:text-5xl">
          Day 1 arrives <em class="not-italic font-semibold text-gold">tomorrow morning</em>
        </h2>
        <p data-reveal class="mt-5 max-w-md text-lg leading-relaxed text-ink-soft">
          Leave your email and the challenge starts tomorrow. No spam, no
          pressure — one useful email a day for seven days, then silence unless
          you ask for more.
        </p>
        <p data-reveal class="mt-6 text-sm text-ink-soft">
          Prefer email? Write to us at
          <a class="font-medium text-gold-dark" href={`mailto:${EMAIL}?subject=7-Day%20Will%20Challenge`}>{EMAIL}</a>
          and we will add you manually.
        </p>
      </div>

      <div data-reveal="scale" class="card petal-tl-sm p-8 md:p-10">
        {/*
          ─────────────────────────────────────────────────────────────
          GHL FORM EMBED GOES HERE
          Paste the GoHighLevel form embed code for the 7-Day Will
          Challenge inside this card, replacing the placeholder below.
          The container is already styled to match the site.
          ─────────────────────────────────────────────────────────────
        */}
        <div class="grid place-items-center rounded-2xl border-2 border-dashed border-line bg-cream-deep/50 px-8 py-16 text-center">
          <div>
            <span class="mx-auto grid size-12 place-items-center rounded-full bg-gold/25 text-gold-dark">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <p class="mt-4 font-heading text-xl font-semibold text-ink">Sign-up form</p>
            <p class="mt-1.5 max-w-[18rem] text-sm leading-relaxed text-ink-soft">
              The GoHighLevel opt-in form for the 7-Day Will Challenge loads here.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternative -->
  <section class="pb-20 md:pb-28">
    <div class="wrap">
      <div data-reveal class="ink-panel petal-bl flex flex-col items-start justify-between gap-8 p-10 md:flex-row md:items-center md:p-12">
        <div class="max-w-xl">
          <h3 class="font-heading text-3xl font-semibold text-cream">Rather skip ahead?</h3>
          <p class="mt-3 leading-relaxed text-cream/70">
            If you already know you need this sorted, the free Risk Profile
            Audit gives you in 30 minutes what the challenge builds over a week.
          </p>
        </div>
        <Button placement="challenge-alt" />
      </div>
    </div>
  </section>
</Base>
