---
import Base from '../../layouts/Base.astro';
import SectionTag from '../../components/ui/SectionTag.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { ARTICLES } from '../../lib/content';
---

<Base
  title="Resources — UAE Wills, Explained in Plain English"
  description="Educational guides for expats: what happens without a registered UAE will, how the three registries compare, and whether your home-country will works here."
>
  <section class="py-20 md:py-28">
    <div class="wrap">
      <div class="max-w-2xl">
        <div data-reveal><SectionTag label="Resources" /></div>
        <h1 data-split class="mt-6 font-heading text-[2.7rem] leading-[1.06] font-medium text-ink sm:text-6xl">
          UAE wills, explained in <em class="not-italic font-semibold text-gold">plain English</em>
        </h1>
        <p data-reveal class="mt-6 text-lg leading-relaxed text-ink-soft">
          No legal jargon, no scare tactics. The facts about UAE wills, the
          registries and the process — so you can decide with a clear head.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          ARTICLES.map((a, i) => (
            <a
              data-reveal
              data-delay={String(i * 0.08)}
              href={`/resources/${a.slug}`}
              class={`card group flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_24px_60px_-24px_rgba(139,99,71,0.4)] ${['petal-tl-sm', 'petal-tr-sm', 'petal-br-sm'][i % 3]}`}
            >
              <div class="overflow-hidden">
                <img
                  src={a.image}
                  alt=""
                  class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <span class="text-xs font-medium uppercase tracking-[0.12em] text-gold-dark">{a.minutes} min read</span>
                <h2 class="mt-3 font-heading text-[1.4rem] leading-snug font-semibold text-ink transition-colors group-hover:text-brown">
                  {a.title}
                </h2>
                <p class="mt-3 flex-1 text-[0.92rem] leading-relaxed text-ink-soft">{a.excerpt}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-gold-dark">
                  Read the guide
                  <svg class="transition-transform duration-300 group-hover:translate-x-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Challenge promo -->
      <div data-reveal class="petal-tr mt-16 grid items-center gap-10 border border-line bg-white/70 p-8 md:grid-cols-2 md:p-12">
        <div>
          <p class="text-[0.75rem] font-medium uppercase tracking-[0.18em] text-gold-dark">Free email course</p>
          <h2 class="mt-3 font-heading text-3xl leading-tight font-semibold text-ink sm:text-4xl">
            The 7-Day Will Challenge
          </h2>
          <p class="mt-4 max-w-md leading-relaxed text-ink-soft">
            One email a day, one pillar a day: why you need a UAE will, the four
            decisions, the registries, translation and registration, and how to
            keep it up to date. Seven days from now, you will understand this
            topic better than most expats ever do.
          </p>
          <a href="/7-day-will-challenge" class="mt-6 inline-flex items-center gap-2 font-medium text-gold-dark transition-colors hover:text-brown">
            Join the free challenge
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <a href="/7-day-will-challenge" class="group relative block overflow-hidden rounded-[1.75rem]">
          <img src="/images/challenge-laptop.jpg" alt="The 7-Day Will Challenge on a laptop" class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <span class="absolute inset-0 bg-gradient-to-t from-ink/40 to-transparent"></span>
          <span class="absolute bottom-5 left-5 rounded-full bg-cream px-4 py-2 text-sm font-medium text-ink">Start day 1 →</span>
        </a>
      </div>
    </div>
  </section>

  <FinalCta />
</Base>
