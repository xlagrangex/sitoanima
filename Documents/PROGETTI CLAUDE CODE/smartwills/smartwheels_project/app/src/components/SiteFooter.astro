---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import { NAV_LINKS, EMAIL, TRUSTPILOT_URL, LEGAL_ENTITY, DISCLAIMER } from '../lib/site';
import { ARTICLES } from '../lib/content';

const year = new Date().getFullYear();

/* ── Scalloped fringe: a continuous run of hanging Bauhaus arches, flush to
   the footer's top edge. One repeating triad of brand tones — deliberate
   rhythm, no scattered shapes. ── */
const gold = 'var(--color-gold)';
const goldDark = 'var(--color-gold-dark)';
const cream = 'var(--color-cream-deep)';

const ARCHES = [gold, cream, goldDark, gold, cream, goldDark, gold, cream];
---

<footer id="site-footer" class="site-footer text-cream">
  <div class="footer-inner ink-panel relative overflow-hidden">
    <div class="relative">
      <!-- ── Hanging arch fringe ── -->
      <div class="grid grid-cols-3 overflow-hidden md:grid-cols-8" aria-hidden="true">
        {
          ARCHES.map((c, i) => (
            <div class:list={['fz relative aspect-[3.2/1]', i >= 3 && 'hidden md:block']}>
              <span class="absolute inset-y-0 left-0 w-1/2 fz-bl" style={`background:${c}`} />
              <span class="absolute inset-y-0 right-0 w-1/2 fz-br" style={`background:${c}`} />
            </div>
          ))
        }
      </div>

      <!-- ── Giant CTA ── -->
      <div class="wrap grid gap-7 pt-10 pb-10 md:grid-cols-[1.6fr_auto] md:items-center md:pt-12 md:pb-12">
        <h2 data-fstagger class="font-heading text-[2.4rem] font-medium leading-[0.98] text-cream sm:text-5xl lg:text-[3.7rem]">
          Peace of mind,<br class="lg:hidden" />
          <em class="not-italic font-semibold text-gold-grad">put in writing.</em>
        </h2>
        <div data-fstagger class="md:justify-self-end">
          <Button placement="footer" />
        </div>
      </div>

      <!-- ── Link columns ── -->
      <div class="border-t border-cream/10">
        <div class="wrap grid gap-10 py-10 md:grid-cols-[1.3fr_1fr_1fr] md:py-11">
          <div data-fstagger>
            <Logo dark />
            <p class="mt-4 max-w-sm text-[0.95rem] leading-relaxed text-cream/70">
              We help expats register their UAE will from start to finish, remotely —
              with 2 to 3 hours of their own time. Every step coordinated: drafting,
              certified translation, government submission and follow-up.
            </p>
            <a
              href={TRUSTPILOT_URL}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex items-center gap-2.5 rounded-full border border-cream/15 px-4 py-2 text-sm transition-colors hover:border-gold/50"
            >
              <span class="flex gap-0.5 text-trust">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.3l7.1-.7z"/></svg>
                ))}
              </span>
              <span class="text-cream/80">Rated <strong class="text-cream">4.6/5</strong> on Trustpilot</span>
            </a>
          </div>

          <div data-fstagger>
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-gold">Explore</h3>
            <ul class="mt-4 space-y-2.5 text-[0.95rem]">
              {NAV_LINKS.map((l) => (
                <li><a class="link-grow text-cream/75 transition-colors hover:text-gold" href={l.href}>{l.label}</a></li>
              ))}
              <li><a class="link-grow text-cream/75 transition-colors hover:text-gold" href="/book-a-call">Book a call</a></li>
            </ul>
          </div>

          <div data-fstagger>
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-gold">Resources</h3>
            <ul class="mt-4 space-y-2.5 text-[0.95rem]">
              {ARTICLES.map((a) => (
                <li><a class="link-grow text-cream/75 transition-colors hover:text-gold" href={`/resources/${a.slug}`}>{a.title.split(':')[0]}</a></li>
              ))}
            </ul>
            <h3 class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-gold">Contact</h3>
            <a class="link-grow mt-3 inline-block text-[0.95rem] text-cream/75 transition-colors hover:text-gold" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </div>
        </div>
      </div>

      <!-- ── Legal + back to top ── -->
      <div class="border-t border-cream/10">
        <div class="wrap flex items-start justify-between gap-8 py-6" data-fstagger>
          <div>
            <p class="text-xs leading-relaxed text-cream/50">
              <strong class="font-medium text-cream/70">{LEGAL_ENTITY}</strong> · {EMAIL}
              <span class="mx-2 text-cream/25">·</span>© {year} SmartWills.ae — All rights reserved.
            </p>
            <p class="mt-3 max-w-4xl text-xs leading-relaxed text-cream/45">
              {DISCLAIMER}
            </p>
          </div>
          <button
            id="footer-to-top"
            class="group grid size-12 shrink-0 place-items-center rounded-full border border-cream/20 text-cream/70 transition-colors duration-300 hover:border-gold hover:bg-gold hover:text-ink"
            aria-label="Back to top"
          >
            <svg class="transition-transform duration-300 group-hover:-translate-y-0.5" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- ── Ghost wordmark, cropped by the footer's bottom edge ── -->
      <div class="pointer-events-none -mt-1 select-none" aria-hidden="true">
        <p
          class="whitespace-nowrap text-center font-heading font-semibold leading-none tracking-tight text-cream/[0.16]"
          style="font-size: clamp(3.5rem, 10.5vw, 9.5rem); transform: translateY(0.44em);"
        >
          SmartWills<span class="text-gold/30">.ae</span>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Curtain reveal: when the whole footer fits in the viewport (JS adds
     .is-curtain), it stays pinned behind the page sheet (main, opaque and
     above) and the last stretch of scroll lifts the sheet off it. Otherwise
     it behaves as a normal footer. */
  .site-footer.is-curtain {
    position: sticky;
    bottom: 0;
    z-index: 0;
  }

  /* The sticky shift leaves the footer's layout slot exposed below it —
     fill that gap with ink so nothing pale peeks under the footer. */
  .site-footer.is-curtain::after {
    content: '';
    position: absolute;
    inset: 100% 0 auto 0;
    height: 100vh;
    background: var(--color-ink);
  }

  /* Arch halves — a rectangle with exactly one 100% corner radius, the same
     construction as the petals in bauhaus-pattern.svg. [bl + br] side by
     side read as one arch hanging from the top edge. */
  .fz-bl { border-radius: 0 0 0 100%; }
  .fz-br { border-radius: 0 0 100% 0; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const footer = document.getElementById('site-footer');
  const inner = footer?.querySelector<HTMLElement>('.footer-inner');
  const main = document.querySelector('main');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.getElementById('footer-to-top')?.addEventListener('click', () => {
    if (reduced) {
      window.scrollTo(0, 0);
    } else {
      gsap.to(document.scrollingElement, { scrollTop: 0, duration: 1.1, ease: 'power3.inOut' });
    }
  });

  if (footer && inner && main && !reduced) {
    /* Curtain mode only when the footer fits the viewport — a sticky footer
       taller than the screen would keep its top edge (the fringe) forever
       hidden behind the sheet. */
    const fits = () => footer.offsetHeight <= window.innerHeight;
    const setMode = () => footer.classList.toggle('is-curtain', fits());
    setMode();
    let raf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        setMode();
        ScrollTrigger.refresh();
      });
    });

    const span = () => Math.min(footer.offsetHeight, window.innerHeight * 0.9);

    /* Depth: in curtain mode the footer content lags behind the lifting
       sheet during the final stretch of scroll. */
    gsap.fromTo(
      inner,
      { yPercent: -16 },
      {
        yPercent: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: main,
          start: 'bottom bottom',
          end: () => `bottom bottom-=${span()}`,
          scrub: 0.4,
          invalidateOnRefresh: true,
        },
      },
    );

    /* Entrance choreography, once, as the reveal begins: the arch fringe
       drops in from the top edge, then the content rows rise. */
    const arches = footer.querySelectorAll<HTMLElement>('.fz');
    const rows = footer.querySelectorAll<HTMLElement>('[data-fstagger]');
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: main,
        start: () => `bottom bottom-=${span() * 0.25}`,
        once: true,
        invalidateOnRefresh: true,
      },
    });
    tl.fromTo(
      arches,
      { yPercent: -101 },
      { yPercent: 0, duration: 0.8, ease: 'power4.out', stagger: { each: 0.06, from: 'center' } },
      0,
    );
    tl.fromTo(
      rows,
      { y: 34, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.9, ease: 'power3.out', stagger: 0.09 },
      0.2,
    );
  }
</script>
