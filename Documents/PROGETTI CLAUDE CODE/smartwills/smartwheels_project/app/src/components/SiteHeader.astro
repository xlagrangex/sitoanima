---
import Logo from './ui/Logo.astro';
import { NAV_LINKS, ctaUrl } from '../lib/site';
import MobileMenu from './react/MobileMenu';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-cream/85 backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-[87.5rem] items-center justify-between px-5 py-4 sm:px-8 lg:px-12">
    <Logo />

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class={`relative text-[0.92rem] font-medium transition-colors hover:text-brown ${
              isActive(link.href) ? 'text-brown' : 'text-ink'
            } ${isActive(link.href) ? 'after:absolute after:-bottom-2 after:left-1/2 after:h-[3px] after:w-7 after:-translate-x-1/2 after:rounded-full after:bg-gold' : ''}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href={ctaUrl('navbar')}
        class="group inline-flex items-center gap-3 rounded-full bg-gold py-1.5 pl-5 pr-1.5 text-sm font-medium text-ink transition-colors duration-300 hover:bg-gold-dark"
      >
        <span>Book a free call</span>
        <span class="grid size-8 place-items-center rounded-full bg-ink text-cream transition-transform duration-300 group-hover:translate-x-0.5">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </div>

    <div class="lg:hidden">
      <MobileMenu client:load pathname={pathname} />
    </div>
  </div>
</header>
