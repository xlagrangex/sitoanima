---
import Button from '../ui/Button.astro';
import { TRUSTPILOT_URL } from '../../lib/site';
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute -top-32 -right-40 size-[34rem] rounded-full bg-gold/15 blur-3xl"></div>

  <div class="relative mx-auto grid w-full max-w-[82rem] items-center gap-16 px-6 py-14 md:px-10 md:py-20 lg:grid-cols-[1fr_1.55fr] lg:gap-10">
    <!-- ── Copy ── -->
    <div>
      <div data-reveal>
        <div class="inline-flex items-center gap-2.5 rounded-full border border-line bg-white/80 px-4 py-2 text-[0.8rem] font-medium text-brown">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold-dark"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          Trusted. Local. Legally coordinated.
        </div>
      </div>

      <h2 data-split class="mt-7 font-heading text-[2.85rem] leading-[0.98] font-medium text-ink sm:text-6xl lg:text-[4.15rem]">
        Secure your legacy. Protect what matters <em class="not-italic font-semibold text-gold">most.</em>
      </h2>

      <p data-reveal data-delay="0.15" class="mt-6 max-w-lg text-lg leading-relaxed text-ink-soft">
        We help UAE expats register their will from start to finish — drafting,
        certified translation and government submission coordinated for you,
        <strong class="font-semibold text-ink">in 2 to 3 hours of your time</strong>.
      </p>

      <div data-reveal data-delay="0.25" class="mt-9 flex flex-wrap items-center gap-7">
        <Button placement="home-showcase" label="Get started" />
        <Button variant="ghost" label="Learn more" href="/how-it-works" placement="home-showcase-secondary" />
      </div>

      <div data-reveal data-delay="0.35" class="mt-11 flex items-center gap-4">
        <div class="flex -space-x-3">
          <span class="grid size-11 place-items-center rounded-full border-2 border-cream bg-brown font-heading text-sm font-semibold text-cream">D</span>
          <span class="grid size-11 place-items-center rounded-full border-2 border-cream bg-gold-dark font-heading text-sm font-semibold text-cream">G</span>
          <span class="grid size-11 place-items-center rounded-full border-2 border-cream bg-ink font-heading text-sm font-semibold text-cream">S</span>
        </div>
        <p class="text-[0.95rem] leading-snug text-ink-soft">
          <strong class="font-semibold text-ink">500+ expat families</strong><br />
          trust SmartWills.ae
        </p>
      </div>
    </div>

    <!-- ── Collage — 8×6 square-cell grid, NO gaps. Radii are exactly 1 cell
         (var(--r1)) or 2 cells (var(--r2)); every other corner is perfectly
         square. Shapes snap to whole cell-blocks. Skyline is a T: top bar
         (cols 3-8 × rows 1-2) + centre pillar (cols 5-6 × rows 3-4), the two
         pieces share one continuous image via background-position.
         border-radius order = top-left top-right bottom-right bottom-left ── -->
    <div class="relative mx-auto w-full max-w-[820px]">
      <div class="petal-grid" style="aspect-ratio: 4 / 3; container-type: inline-size; display:grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(6, 1fr); gap:0;">

        <!-- gold shield card — cols 1-2 × rows 1-2. Round = top-left, 2 cells -->
        <div data-bloom class="flex flex-col items-start justify-center gap-[10%] bg-gold p-[13%] text-ink" style="grid-column:1 / 3; grid-row:1 / 3; border-radius: var(--r2) 0 0 0;">
          <svg style="width:21%; height:auto;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          <p class="font-medium leading-snug" style="font-size:clamp(0.62rem, 2.7cqw, 0.98rem);">Legally valid<br />in the UAE</p>
        </div>

        <!-- skyline TOP BAR — cols 3-8 × rows 1-2. Round top-left (1) + bottom-right sweep (1) -->
        <div data-bloom style="grid-column:3 / 9; grid-row:1 / 3; border-radius: var(--r1) 0 var(--r1) 0; background-image:url(/images/hero-skyline.jpg); background-size:100% 200%; background-position:50% 0%; z-index:1;"></div>

        <!-- skyline PILLAR — cols 5-6 × rows 3-4. Same image continued (centre-bottom) -->
        <div data-bloom style="grid-column:5 / 7; grid-row:3 / 5; background-image:url(/images/hero-skyline.jpg); background-size:300% 200%; background-position:50% 100%; z-index:1;"></div>

        <!-- family photo — cols 1-2 × rows 3-4. Rounds = left side (TL + BL, 1 cell) -->
        <div data-bloom class="overflow-hidden" style="grid-column:1 / 3; grid-row:3 / 5; border-radius: var(--r1) 0 0 var(--r1); z-index:1;">
          <img src="/images/hero-family.jpg" alt="An Emirati family at home" class="h-full w-full object-cover" loading="lazy" />
        </div>

        <!-- skyline behind the private card — the rounded top-right corner cuts
             away to reveal the cityscape. Same background math as the top bar and
             pillar (image scaled to the full cols3-9 × rows1-5 skyline canvas), so
             the revealed slice is a seamless continuation, not a repeated crop.
             cols3-5 is the left third of that canvas, rows3-5 its bottom half. -->
        <div data-bloom style="grid-column:3 / 5; grid-row:3 / 5; background-image:url(/images/hero-skyline.jpg); background-size:300% 200%; background-position:0% 100%; z-index:2;"></div>

        <!-- private & confidential card — cols 3-4 × rows 3-4. Round = top-right (2 cells) reveals skyline -->
        <div data-bloom class="flex flex-col items-start justify-center gap-[10%] bg-cream p-[13%] text-ink" style="grid-column:3 / 5; grid-row:3 / 5; border-radius: 0 var(--r2) 0 0; z-index:3;">
          <svg style="width:21%; height:auto;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <p class="font-medium leading-snug" style="font-size:clamp(0.62rem, 2.7cqw, 0.98rem);">Private &amp;<br />Confidential</p>
        </div>

        <!-- cream blob — cols 7-8 × rows 3-4. Full circle inscribed in the 2×2 block -->
        <div data-bloom style="grid-column:7 / 9; grid-row:3 / 5; display:flex; align-items:center; justify-content:center; z-index:2;">
          <div class="rounded-full bg-cream-deep/70" style="height:100%; aspect-ratio:1;"></div>
        </div>

        <!-- expert guidance gold card — cols 1-2 × rows 5-6. Round = bottom-left (1 cell) -->
        <div data-bloom class="flex flex-col items-start justify-center gap-[10%] bg-gold p-[13%] text-ink" style="grid-column:1 / 3; grid-row:5 / 7; border-radius: 0 0 0 var(--r1);">
          <svg style="width:21%; height:auto;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
          <p class="font-medium leading-snug" style="font-size:clamp(0.62rem, 2.7cqw, 0.98rem);">Expert guidance<br />every step of the way</p>
        </div>

        <!-- palm — cols 3-6 × rows 5-6. Round = top-right sweep (2) + bottom-left (2) -->
        <div data-bloom class="overflow-hidden" style="grid-column:3 / 7; grid-row:5 / 7; border-radius: 0 var(--r2) 0 var(--r2); z-index:2;">
          <img src="/images/hero-palm.jpg" alt="Palm trees and villas in Dubai" class="h-full w-full object-cover" loading="lazy" />
        </div>

        <!-- gold circle — cols 7-8 × rows 5-6. Full circle inscribed in the 2×2 block -->
        <div data-bloom style="grid-column:7 / 9; grid-row:5 / 7; display:flex; align-items:center; justify-content:center; z-index:1;">
          <div class="rounded-full bg-gold" style="height:100%; aspect-ratio:1;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Feature strip — reference bottom band ── -->
  <div class="border-t border-line/80">
    <div class="wrap grid grid-cols-2 gap-y-8 py-9 md:grid-cols-4 md:gap-x-8">
      <div data-reveal class="flex items-start gap-4 md:border-r md:border-line/80 md:pr-8">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-cream-deep text-brown">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <p class="text-[0.88rem] leading-snug"><strong class="font-semibold text-ink">Legally coordinated</strong><br /><span class="text-ink-soft">Drafting, translation and submission handled for you</span></p>
      </div>
      <div data-reveal data-delay="0.08" class="flex items-start gap-4 md:border-r md:border-line/80 md:pr-8">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-cream-deep text-brown">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <p class="text-[0.88rem] leading-snug"><strong class="font-semibold text-ink">For expats &amp; residents</strong><br /><span class="text-ink-soft">Serving all nationalities across the UAE</span></p>
      </div>
      <div data-reveal data-delay="0.16" class="flex items-start gap-4 md:border-r md:border-line/80 md:pr-8">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-cream-deep text-brown">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
        </span>
        <p class="text-[0.88rem] leading-snug"><strong class="font-semibold text-ink">Clear &amp; simple process</strong><br /><span class="text-ink-soft">2–3 hours of your time, fully remote</span></p>
      </div>
      <div data-reveal data-delay="0.24" class="flex items-start gap-4">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-cream-deep text-trust">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.3l7.1-.7z"/></svg>
        </span>
        <a href={TRUSTPILOT_URL} target="_blank" rel="noopener" class="text-[0.88rem] leading-snug transition-colors hover:text-ink"><strong class="font-semibold text-ink">Rated 4.6/5</strong><br /><span class="text-ink-soft">on Trustpilot, by expats like you</span></a>
      </div>
    </div>
  </div>
</section>
