---
import Button from '../ui/Button.astro';
import { GUARANTEE } from '../../lib/content';

interface Props {
  title?: string;
}

const { title = 'The hardest part was landing here' } = Astro.props;
---

<section class="py-20 md:py-28">
  <div class="wrap">
    <div data-reveal class="ink-panel petal-tr relative overflow-hidden px-8 py-16 md:px-16 md:py-24">
      <div class="disc pointer-events-none absolute -top-20 -right-20 size-72 bg-gold/15"></div>
      <div class="disc pointer-events-none absolute -bottom-28 -left-16 size-80 bg-gold/10"></div>

      <div class="relative grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-[0.75rem] font-medium uppercase tracking-[0.18em] text-gold">Your next step</p>
          <h2 data-split class="mt-5 max-w-xl font-heading text-4xl leading-[1.1] font-medium text-cream sm:text-5xl">
            {title}
          </h2>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-cream/70">
            Most expats live here for a decade without ever sorting this out.
            Thirty minutes, zero pressure — and you finally know exactly what
            your situation needs.
          </p>
          <div class="mt-9 flex flex-col items-start gap-5">
            <Button placement="final-cta" />
            <a href="/7-day-will-challenge" class="text-sm font-medium text-cream/70 transition-colors hover:text-gold">
              Prefer to learn first? Join the free 7-Day Will Challenge →
            </a>
          </div>
        </div>

        <div>
          <ol>
            <li class="flex items-center gap-6 border-t border-cream/12 py-5">
              <span class="font-heading text-[2.2rem] font-semibold text-gold">1</span>
              <p class="text-[0.95rem] leading-relaxed text-cream/80">Book your free Risk Profile Audit — it takes 2 minutes.</p>
            </li>
            <li class="flex items-center gap-6 border-t border-cream/12 py-5">
              <span class="font-heading text-[2.2rem] font-semibold text-gold">2</span>
              <p class="text-[0.95rem] leading-relaxed text-cream/80">Understand your options: registry, single or mirror, documents.</p>
            </li>
            <li class="flex items-center gap-6 border-y border-cream/12 py-5">
              <span class="font-heading text-[2.2rem] font-semibold text-gold">3</span>
              <p class="text-[0.95rem] leading-relaxed text-cream/80">Decide if SmartWills is right for you. No obligation either way.</p>
            </li>
          </ol>
          <p class="mt-7 flex items-center gap-2.5 text-sm text-cream/60">
            <svg class="shrink-0 text-gold" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <span><strong class="font-medium text-cream/80">Our guarantee:</strong> {GUARANTEE}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
