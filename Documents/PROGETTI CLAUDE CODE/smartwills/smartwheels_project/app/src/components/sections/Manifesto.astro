---
import BauhausDecor from '../ui/BauhausDecor.astro';
---

<section class="ink-panel relative overflow-hidden py-24 md:py-36">
  <BauhausDecor type="orb" color="gold" size="size-[26rem]" opacity={0.13} class="-bottom-44 -left-44" />
  <BauhausDecor type="disc" color="gold" size="size-64" opacity={0.11} class="-top-24 -right-24" />
  <BauhausDecor type="disc" color="gold-dark" size="size-40" opacity={0.09} class="bottom-10 right-[10%]" />
  <div class="relative z-10 wrap">
    <p data-highlight class="mx-auto max-w-4xl text-center font-heading text-[2rem] leading-[1.25] font-medium text-cream sm:text-4xl md:text-[2.9rem]">
      Most expats postpone their will for years — not because it doesn’t matter,
      but because nobody made it simple enough to finish.
      <span class="text-gold">We exist so that “I’ll do it later” finally becomes “it’s done”.</span>
    </p>
  </div>
</section>
