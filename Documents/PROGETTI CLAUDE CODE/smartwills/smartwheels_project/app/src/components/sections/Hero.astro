---
import MobileMenu from '../react/MobileMenu';
import { NAV_LINKS, ctaUrl } from '../../lib/site';

const pathname = Astro.url.pathname;

/* Slideshow behind the portrait area — purple duotone so every photo melts
   into the panel exactly like the reference portrait. */
const slides = [
  { src: '/images/hero-family.jpg', alt: 'A family walking together at home' },
  { src: '/images/hero-skyline.jpg', alt: 'Dubai skyline and Burj Khalifa at golden hour' },
  { src: '/images/resources-marina.jpg', alt: 'Dubai Marina waterfront at sunset' },
];

const bookUrl = ctaUrl('navbar');
---

<section class="hero-page relative px-2.5 pt-2.5 pb-2.5 sm:px-4 sm:pt-4 sm:pb-4">
  <!-- ── One dark shell: nav bar on top, purple panel inside, moulded pockets ── -->
  <div class="relative mx-auto flex w-full max-w-[112rem] flex-col overflow-hidden rounded-[1.9rem] bg-shell p-2.5 sm:p-3" style="min-height: clamp(600px, 94vh, 920px);">
    <!-- ── Top bar: logo left, links centre-right ── -->
    <div class="relative z-30 flex items-center gap-8 px-3 py-3.5 sm:px-5 lg:pr-56">
      <a href="/" class="flex items-baseline gap-1.5 select-none" aria-label="SmartWills.ae — home">
        <span class="rounded-[0.55rem] bg-white px-2.5 py-1 font-body text-[1.15rem] leading-none font-bold text-shell">Smart</span>
        <span class="font-body text-[1.15rem] leading-none font-bold text-white">Wills.ae</span>
      </a>

      <nav class="ml-auto hidden items-center gap-9 lg:flex" aria-label="Main">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="text-[0.92rem] font-medium text-white/85 transition-colors hover:text-white">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="ml-auto lg:hidden">
        <MobileMenu client:load pathname={pathname} />
      </div>
    </div>

    <!-- ── Register Now — light tab moulded into the shell's top-right corner ── -->
    <div class="tab-register absolute top-0 right-0 z-40 hidden lg:block">
      <span class="fill fill-tab fill-tab-left"></span>
      <span class="fill fill-tab fill-tab-below"></span>
      <a href={ctaUrl('register-now')} class="group flex items-center gap-4 py-5 pr-7 pl-9 text-[0.95rem] font-medium text-white">
        <span>Register Now</span>
        <span class="grid size-11 place-items-center rounded-full border border-white/80 transition-transform duration-300 group-hover:rotate-45">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </span>
      </a>
    </div>

    <!-- ── Purple panel ── -->
    <div class="hero-panel relative flex-1 overflow-hidden rounded-[1.5rem]">
      <!-- portrait slideshow, right side, melted into the purple -->
      <div id="hero-slider" class="absolute inset-0 lg:left-auto lg:right-0 lg:w-[62%] hero-fade">
        {
          slides.map((s, i) => (
            <div class:list={['dslide', { 'is-active': i === 0 }]} style={`background-image:url(${s.src})`} role="img" aria-label={s.alt} />
          ))
        }
      </div>
      <!-- legibility veil on small screens where the image sits behind the copy -->
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#5551dd]/85 via-[#5551dd]/45 to-transparent lg:hidden"></span>

      <!-- ── Copy ── -->
      <div class="relative z-20 flex h-full max-w-3xl flex-col items-start justify-center gap-8 px-6 pt-14 pb-40 sm:px-12 lg:px-16 lg:pt-10 lg:pb-32">
        <div data-reveal>
          <span class="inline-flex items-center rounded-full border border-white/70 px-6 py-2.5 text-[0.9rem] font-medium text-white">
            Secure Your Legacy
          </span>
        </div>

        <h1 data-split class="hero-h1 text-[clamp(3.4rem,9.5vw,7.5rem)] font-bold leading-[1.02] text-white">
          Your<br />Legacy<br />Matters
        </h1>

        <div data-reveal data-delay="0.15" class="flex flex-col gap-7">
          <p class="max-w-xl text-[1.15rem] leading-relaxed font-medium text-white">
            SmartWills helps UAE expats protect what matters most — will drafting,
            certified translation and government registration, coordinated for you
            from start to finish.
          </p>
          <span class="h-px w-72 max-w-full bg-white/80"></span>
        </div>
      </div>

      <!-- ── Slider dots — dark pocket, bottom-right ── -->
      <div class="pocket-dots absolute right-0 bottom-0 z-20">
        <span class="fill fill-dark fill-dots-above"></span>
        <span class="fill fill-dark fill-dots-left"></span>
        <div id="hero-dots" class="flex items-center gap-2.5">
          {
            slides.map((_, i) => (
              <button class:list={['ddot', { 'is-active': i === 0 }]} data-i={i} aria-label={`Show view ${i + 1}`} />
            ))
          }
        </div>
      </div>
    </div>

    <!-- ── Lime CTA — moulded into the shell's bottom-left corner ── -->
    <div class="pocket-cta absolute bottom-0 left-0 z-30 w-full max-w-[46rem] pr-8 sm:w-[62%] lg:w-[44%]">
      <span class="fill fill-dark fill-cta-above"></span>
      <span class="fill fill-dark fill-cta-right"></span>
      <a
        href={bookUrl}
        class="group flex w-full items-center justify-between gap-4 rounded-[1.4rem] bg-lime py-4 pl-7 pr-4 text-[1.15rem] font-semibold text-shell transition-colors duration-300 hover:bg-[#e6ff70] sm:py-5 sm:pl-9 sm:text-[1.4rem]"
      >
        <span>Book a Free Call</span>
        <span class="grid size-12 shrink-0 place-items-center rounded-full border-[1.5px] border-shell transition-transform duration-300 group-hover:rotate-45 sm:size-14">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Reference palette — scoped to the hero */
  .hero-page {
    --shell: #141318;
    --purple: #5551dd;
    --purple-glow: #8f83f0;
    --lime: #d6f651;
    --tab: #9296ef;
    background:
      radial-gradient(120% 100% at 50% 0%, #f6effc 0%, #ead9f7 55%, #e2ccf3 100%);
  }
  .hero-h1 {
    font-family: var(--font-body);
    letter-spacing: -0.02em;
  }
  .bg-shell { background: var(--shell); }
  .text-shell { color: var(--shell); }
  .bg-lime { background: var(--lime); }

  /* Purple panel: flat indigo with a soft lighter halo behind the portrait */
  .hero-panel {
    background:
      radial-gradient(55rem 42rem at 68% 42%, var(--purple-glow) 0%, var(--purple) 55%, #4d49d0 100%);
  }

  /* Slides: purple duotone (grayscale + luminosity blend picks up the panel
     hue) so any photo melts into the background like the reference portrait */
  .hero-fade {
    /* the mask isolates blending, so the slider carries its own purple
       backdrop for the luminosity duotone to tint against */
    background: radial-gradient(55rem 42rem at 48% 42%, var(--purple-glow) 0%, var(--purple) 55%, #4d49d0 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 26%);
    mask-image: linear-gradient(to right, transparent 0%, #000 26%);
  }
  @media (max-width: 1023px) {
    .hero-fade {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  .dslide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.18) brightness(0.72);
    mix-blend-mode: luminosity;
    opacity: 0;
    transition: opacity 1.2s ease;
    will-change: opacity;
  }
  .dslide.is-active { opacity: 1; }

  .ddot {
    height: 9px;
    width: 9px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.4);
    transition: width 0.35s ease, background 0.35s ease;
  }
  .ddot.is-active {
    width: 30px;
    background: #fff;
  }

  /* ── Moulded pockets & tab — concave fillets, same language as the reference ── */
  .fill {
    --r: 24px;
    position: absolute;
    width: var(--r);
    height: var(--r);
    pointer-events: none;
  }
  /* dark fillets: concave arc facing the purple panel */
  .fill-dark { background: radial-gradient(circle var(--r) at 100% 0, transparent calc(var(--r) - 0.5px), var(--shell) var(--r)); }
  .fill-dots-above { top: calc(-1 * var(--r)); right: 0; transform: scaleX(-1); }
  .fill-dots-left { bottom: 0; left: calc(-1 * var(--r)); transform: scaleX(-1); }
  .fill-cta-above { top: calc(-1 * var(--r)); left: 0; }
  .fill-cta-right { bottom: 0; right: calc(-1 * var(--r) + 2rem); }

  .pocket-cta { background: var(--shell); border-top-right-radius: 1.6rem; padding: 0.8rem 2rem 0.65rem 0.65rem; }
  .pocket-dots { background: var(--shell); border-top-left-radius: 1.3rem; padding: 1rem 1.1rem 0.9rem 1.3rem; }

  /* Register tab: light periwinkle corner with concave joins into the dark bar */
  .tab-register {
    background: var(--tab);
    border-top-right-radius: 1.9rem;
    border-bottom-left-radius: 1.6rem;
  }
  .fill-tab { background: radial-gradient(circle var(--r) at 0 100%, transparent calc(var(--r) - 0.5px), var(--tab) var(--r)); }
  .fill-tab-left { top: 0; left: calc(-1 * var(--r)); }
  .fill-tab-below { top: 100%; right: 0; }

  @media (prefers-reduced-motion: reduce) {
    .dslide { transition: none; }
  }
</style>

<script>
  const root = document.getElementById('hero-slider');
  const dotsWrap = document.getElementById('hero-dots');
  if (root && dotsWrap) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.dslide'));
    const dots = Array.from(dotsWrap.querySelectorAll<HTMLElement>('.ddot'));
    let index = 0;
    let timer = 0;

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === index));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === index));
    };
    const start = () => { timer = window.setInterval(() => show(index + 1), 5000); };
    const reset = () => { window.clearInterval(timer); start(); };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.i));
        reset();
      }),
    );
    start();
  }
</script>
