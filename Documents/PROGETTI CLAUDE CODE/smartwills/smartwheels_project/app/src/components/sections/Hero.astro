---
import Logo from '../ui/Logo.astro';
import MobileMenu from '../react/MobileMenu';
import { NAV_LINKS, ctaUrl } from '../../lib/site';

const pathname = Astro.url.pathname;

const slides = [
  { src: '/images/hero-family.jpg', alt: 'A family walking together at home' },
  { src: '/images/hero-skyline.jpg', alt: 'Dubai skyline and Burj Khalifa at golden hour' },
  { src: '/images/resources-marina.jpg', alt: 'Dubai Marina waterfront at sunset' },
];

const bookUrl = ctaUrl('navbar');
---

<section class="hero-page relative px-2.5 pt-2.5 pb-2.5 sm:px-4 sm:pt-4 sm:pb-4">
  <div class="relative mx-auto flex w-full max-w-[87.5rem] flex-col rounded-[1.9rem] p-2.5 sm:p-3" style="min-height: clamp(560px, 88vh, 840px); background: var(--shell);">
    <!-- ── Top bar: logo left, links centre-right ── -->
    <div class="relative z-30 flex h-[76px] items-center gap-8 px-3 sm:px-5 lg:pr-[280px]">
      <Logo />

      <nav class="ml-auto hidden items-center gap-7 lg:flex" aria-label="Main">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="text-[1.05rem] font-medium text-ink/75 transition-colors hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="ml-auto lg:hidden">
        <MobileMenu client:load pathname={pathname} />
      </div>
    </div>

    <!-- ── Ink panel: copy + dots ── -->
    <div class="hero-panel relative flex-1 overflow-hidden">
      <div class="relative z-20 flex h-full max-w-3xl flex-col items-start justify-center gap-8 px-6 pt-14 pb-40 sm:px-12 lg:px-16 lg:pt-10 lg:pb-32">
        <div data-reveal>
          <span class="inline-flex items-center gap-2.5 rounded-full border border-cream/30 px-5 py-2.5 text-[0.85rem] font-medium text-cream/90">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            Trusted. Local. Legally coordinated.
          </span>
        </div>

        <h1 data-split class="font-heading max-w-2xl text-[clamp(2.9rem,4.8vw,4.7rem)] font-medium leading-[1.02] text-cream">
          Secure your legacy. Protect what matters <em class="not-italic font-semibold text-gold">most.</em>
        </h1>

        <div data-reveal data-delay="0.15" class="flex flex-col gap-7">
          <p class="max-w-xl text-[1.1rem] leading-relaxed text-cream/80">
            We help UAE expats register their will from start to finish — drafting,
            certified translation and government submission coordinated for you,
            <strong class="font-semibold text-cream">in 2 to 3 hours of your time</strong>.
          </p>
          <span class="h-px w-72 max-w-full bg-cream/50"></span>
          <div class="flex items-center gap-4">
            <div class="flex -space-x-3">
              <span class="grid size-10 place-items-center rounded-full border-2 border-ink bg-brown font-heading text-sm font-semibold text-cream">D</span>
              <span class="grid size-10 place-items-center rounded-full border-2 border-ink bg-gold-dark font-heading text-sm font-semibold text-cream">G</span>
              <span class="grid size-10 place-items-center rounded-full border-2 border-ink bg-cream font-heading text-sm font-semibold text-ink">S</span>
            </div>
            <p class="text-[0.9rem] leading-snug text-cream/70">
              <strong class="font-semibold text-cream">500+ expat families</strong> trust SmartWills.ae
            </p>
          </div>
        </div>
      </div>

      <!-- slider dots — light pocket, bottom-right -->
      <div class="pocket-dots absolute right-0 bottom-0 z-20">
        <span class="fill fill-shell fill-dots-above"></span>
        <div id="hero-dots" class="flex items-center gap-2.5">
          {
            slides.map((_, i) => (
              <button class:list={['ddot', { 'is-active': i === 0 }]} data-i={i} aria-label={`Show view ${i + 1}`} />
            ))
          }
        </div>
      </div>
    </div>

    <!-- ── The image: ONE continuous surface. On desktop it rises past the nav
         bar into the top-right corner, where Register Now sits directly on it. ── -->
    <div id="hero-slider" class="hero-media absolute z-10 overflow-hidden">
      {
        slides.map((s, i) => (
          <div class:list={['dslide', { 'is-active': i === 0 }]} style={`background-image:url(${s.src})`} role="img" aria-label={s.alt} />
        ))
      }
      <!-- legibility veil where copy sits over the image on small screens -->
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink/70 via-ink/40 to-ink/10 lg:hidden"></span>
      <!-- soft scrim in the Register corner so the label stays readable -->
      <span class="tab-scrim pointer-events-none absolute top-0 right-0 hidden lg:block"></span>
    </div>

    <!-- ── Cream cover: hides the image strip left of the Register corner and
         moulds the notch, so the image reads as continuous under the button ── -->
    <div class="hero-cover absolute top-0 left-0 z-20 hidden lg:block"></div>

    <!-- ── Register Now — resting ON the image, same background, no separation ── -->
    <a
      href={ctaUrl('register-now')}
      class="group absolute top-0 right-0 z-40 hidden h-[88px] w-[250px] items-center justify-center gap-3.5 pt-1.5 text-[1.1rem] font-semibold text-white lg:flex"
    >
      <span>Register Now</span>
      <span class="grid size-12 place-items-center rounded-full border-[1.5px] border-white/90 transition-transform duration-300 group-hover:rotate-45">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </span>
    </a>

    <!-- ── Lime CTA — moulded into the bottom-left corner ── -->
    <div class="pocket-cta absolute bottom-0 left-0 z-30 w-full max-w-[46rem] pr-8 sm:w-[62%] lg:w-[44%]">
      <span class="fill fill-shell fill-cta-above"></span>
      <span class="fill fill-shell fill-cta-right"></span>
      <a
        href={bookUrl}
        class="cta-bar group flex w-full items-center justify-between gap-4 bg-gold py-4 pl-7 pr-4 text-[1.15rem] font-semibold text-ink transition-colors duration-300 hover:bg-gold-dark sm:py-5 sm:pl-9 sm:text-[1.4rem]"
      >
        <span>Get started</span>
        <span class="grid size-12 shrink-0 place-items-center rounded-full border-[1.5px] border-ink transition-transform duration-300 group-hover:rotate-45 sm:size-14">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-page {
    /* the frame shares the site's background, so the purple panel floats on it */
    --shell: var(--color-cream);
    --pad: 0.625rem;
    --navh: 76px;
    --tabw: 250px;
    /* Bauhaus radii — same two sizes as the petal system: an arc spans one
       "box" (--rs) or two (--rl); every other corner is dead straight. */
    --rl: clamp(4.5rem, 9vw, 9rem);
    --rs: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 640px) {
    .hero-page { --pad: 0.75rem; }
  }
  .hero-panel {
    background:
      radial-gradient(1200px 500px at 85% -10%, rgba(201, 166, 104, 0.16), transparent 60%),
      var(--color-ink);
    /* one grand two-box arc top-left, everything else square */
    border-radius: var(--rl) 0 0 0;
  }

  /* ── The continuous image surface ── */
  .hero-media {
    left: var(--pad);
    right: var(--pad);
    top: calc(var(--pad) + var(--navh));
    bottom: var(--pad);
    border-radius: var(--rl) 0 0 0;
  }
  @media (min-width: 1024px) {
    .hero-media {
      left: auto;
      width: 62%;
      top: var(--pad);
      /* dead-square top-right corner — the Bauhaus "stacco" */
      border-radius: 0;
      /* fade the left edge into the purple panel */
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 26%);
      mask-image: linear-gradient(to right, transparent 0%, #000 26%);
    }
  }
  .dslide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
    will-change: opacity;
  }
  .dslide.is-active { opacity: 1; }

  .tab-scrim {
    width: calc(var(--tabw) + 2rem);
    height: calc(var(--navh) + 2rem);
    background: radial-gradient(120% 120% at 85% 0%, rgba(20, 19, 24, 0.55) 0%, rgba(20, 19, 24, 0.22) 55%, transparent 100%);
  }

  /* ── Cream cover shaping the notch left of Register Now ── */
  /* One clean quarter-arc where the bar meets the image — a single continuous
     curve, no stacked fillets. The image's own corner above stays dead square. */
  .hero-cover {
    right: calc(var(--pad) + var(--tabw));
    height: calc(var(--pad) + var(--navh));
    background: var(--shell);
    border-bottom-right-radius: var(--rs);
  }

  .ddot {
    height: 9px;
    width: 9px;
    border-radius: 9999px;
    background: rgba(26, 22, 18, 0.25);
    transition: width 0.35s ease, background 0.35s ease;
  }
  .ddot.is-active {
    width: 30px;
    background: var(--color-gold-dark);
  }

  /* ── Moulded pockets — concave fillets in the page colour ── */
  .fill {
    --r: var(--rs);
    position: absolute;
    width: var(--r);
    height: var(--r);
    pointer-events: none;
  }
  .fill-shell { background: radial-gradient(circle var(--r) at 100% 0, transparent calc(var(--r) - 0.5px), var(--shell) var(--r)); }
  .fill-dots-above { top: calc(-1 * var(--r)); right: 0; transform: scaleX(-1); }
  .fill-cta-above { top: calc(-1 * var(--r)); left: 0; }
  .fill-cta-right { bottom: 0.75rem; right: calc(-1 * var(--r)); }

  .pocket-cta { background: var(--shell); border-top-right-radius: var(--rs); padding: 0.8rem 2rem 0.65rem 0.65rem; }
  /* left side dead square (the second "stacco"); only the right joint is moulded */
  .pocket-dots { background: var(--shell); padding: 1.4rem 1.2rem 1.2rem 1.5rem; }

  /* CTA bar — opposite one-box sweeps, like the palm tile in the collage */
  .cta-bar { border-radius: 0 var(--rs) 0 var(--rs); }

  @media (prefers-reduced-motion: reduce) {
    .dslide { transition: none; }
  }
</style>

<script>
  const root = document.getElementById('hero-slider');
  const dotsWrap = document.getElementById('hero-dots');
  if (root && dotsWrap) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.dslide'));
    const dots = Array.from(dotsWrap.querySelectorAll<HTMLElement>('.ddot'));
    let index = 0;
    let timer = 0;

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === index));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === index));
    };
    const start = () => { timer = window.setInterval(() => show(index + 1), 5000); };
    const reset = () => { window.clearInterval(timer); start(); };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.i));
        reset();
      }),
    );
    start();
  }
</script>
