---
import Logo from '../ui/Logo.astro';
import MobileMenu from '../react/MobileMenu';
import { NAV_LINKS, ctaUrl } from '../../lib/site';

const pathname = Astro.url.pathname;

/* Slideshow — first a family (people), then Dubai, then more. Each slide slowly
   zooms (Ken Burns) and auto-advances every 5s. */
const slides = [
  { src: '/images/hero-family.jpg', alt: 'A family walking together at home' },
  { src: '/images/hero-skyline.jpg', alt: 'Dubai skyline and Burj Khalifa at golden hour' },
  { src: '/images/resources-marina.jpg', alt: 'Dubai Marina waterfront at sunset' },
];

const bookUrl = ctaUrl('navbar');
---

<section class="relative px-3 pt-4 pb-2 sm:px-5 md:pt-6 lg:px-8">
  <!-- Register — lives OUTSIDE the box, in the cream margin, top-right. The shell
       is moulded (a concave bite in its top-right corner) so the cream flows in
       and the button nests in it. -->
  <a
    href={bookUrl}
    class="group absolute top-8 right-9 z-40 hidden items-center gap-3 rounded-full border border-ink/20 bg-cream/70 py-1.5 pl-5 pr-1.5 text-sm font-medium text-ink backdrop-blur-sm transition-colors duration-300 hover:border-ink/40 lg:right-12 lg:inline-flex"
  >
    <span>Register now</span>
    <span class="grid size-8 place-items-center rounded-full bg-ink text-cream transition-transform duration-300 group-hover:translate-x-0.5">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
    </span>
  </a>

  <!-- One dark shell. The image fills the right side to the top-right corner; the
       nav links live on the dark left. The image's left edge is a big concave
       sweep (the sagoma), and the shell's top-right is bitten so the Register
       button (outside, on cream) nests into a moulded notch. -->
  <div class="frame relative mx-auto w-full max-w-[112rem] overflow-hidden rounded-[2.4rem] bg-ink" style="min-height: clamp(560px, 84vh, 840px);">
    <!-- ── Image (full height, right) with the concave sagoma on its left ── -->
    <div id="hero-slider" class="petal-bl absolute inset-y-0 right-0 w-full overflow-hidden lg:w-[57%]">
      {
        slides.map((s, i) => (
          <div class:list={['dslide', { 'is-active': i === 0 }]} style={`background-image:url(${s.src})`} role="img" aria-label={s.alt} />
        ))
      }
      <!-- darken for legibility of the nav over the image on small screens -->
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-l from-transparent via-transparent to-ink/50 lg:hidden"></span>

      <!-- slider dots — bottom-right, moulded into the shell -->
      <div class="pocket-dots absolute right-0 bottom-0 z-20">
        <span class="fx fx-tl fx-dots-left"></span>
        <div id="hero-dots" class="flex items-center gap-2.5">
          {
            slides.map((_, i) => (
              <button class:list={['ddot', { 'is-active': i === 0 }]} data-i={i} aria-label={`Show view ${i + 1}`} />
            ))
          }
        </div>
      </div>
    </div>

    <!-- ── Nav: logo + links on the dark left ── -->
    <div class="relative z-30 flex items-center gap-8 px-6 py-5 md:px-9">
      <Logo dark />
      <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="text-[0.9rem] font-medium text-cream/80 transition-colors hover:text-cream">
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto lg:hidden">
        <MobileMenu client:load pathname={pathname} />
      </div>
    </div>

    <!-- ── Copy — dark left column ── -->
    <div class="relative z-20 flex max-w-xl flex-col justify-center gap-7 px-7 pt-6 pb-24 sm:px-10 md:px-14 lg:max-w-[46%]" style="min-height: clamp(420px, 66vh, 700px);">
      <div data-reveal>
        <span class="inline-flex items-center gap-2.5 rounded-full border border-white/25 px-4 py-2 text-[0.8rem] font-medium text-cream/90">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          Trusted. Local. Legally coordinated.
        </span>
      </div>

      <h1 data-split class="font-heading text-[2.9rem] font-medium leading-[0.95] text-cream sm:text-6xl lg:text-[4.2rem]">
        Secure your legacy. Protect what matters <em class="not-italic font-semibold text-gold">most.</em>
      </h1>

      <p data-reveal data-delay="0.15" class="max-w-md text-[1.05rem] leading-relaxed text-cream/70">
        We help UAE expats register their will from start to finish — drafting,
        certified translation and government submission coordinated for you,
        <strong class="font-semibold text-cream">in 2 to 3 hours of your time</strong>.
      </p>

      <div data-reveal data-delay="0.3" class="mt-2 flex items-center gap-4">
        <div class="flex -space-x-3">
          <span class="grid size-10 place-items-center rounded-full border-2 border-ink bg-brown font-heading text-sm font-semibold text-cream">D</span>
          <span class="grid size-10 place-items-center rounded-full border-2 border-ink bg-gold-dark font-heading text-sm font-semibold text-cream">G</span>
          <span class="grid size-10 place-items-center rounded-full border-2 border-ink bg-cream font-heading text-sm font-semibold text-ink">S</span>
        </div>
        <p class="text-[0.9rem] leading-snug text-cream/70">
          <strong class="font-semibold text-cream">500+ expat families</strong> trust SmartWills.ae
        </p>
      </div>
    </div>

    <!-- ── Moulded CTA — bottom-left pocket in the shell ── -->
    <div class="pocket-cta absolute bottom-0 left-0 z-30">
      <span class="fx fx-br fx-cta-right"></span>
      <a
        href={bookUrl}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-3 rounded-full bg-gold py-2.5 pl-6 pr-2 text-[0.95rem] font-medium text-ink transition-colors duration-300 hover:bg-gold-dark"
      >
        <span>Get started</span>
        <span class="grid size-9 place-items-center rounded-full bg-ink text-cream transition-transform duration-300 group-hover:translate-x-1">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Concave bite in the shell's top-right corner so the cream page shows through
     and the Register button (outside, on cream) nests into a moulded notch. */
  .frame {
    --rnotch: clamp(120px, 13vw, 190px);
    -webkit-mask: radial-gradient(circle var(--rnotch) at 100% 0, #0000 calc(var(--rnotch) - 0.5px), #000 var(--rnotch));
    mask: radial-gradient(circle var(--rnotch) at 100% 0, #0000 calc(var(--rnotch) - 0.5px), #000 var(--rnotch));
  }

  .dslide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transform: scale(1.03);
    transition: opacity 1.2s ease;
    will-change: opacity, transform;
  }
  .dslide.is-active {
    opacity: 1;
    animation: kenburns 6s ease-out forwards;
  }
  @keyframes kenburns {
    from { transform: scale(1.03); }
    to { transform: scale(1.15); }
  }

  .ddot {
    height: 8px;
    width: 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.6);
    transition: width 0.35s ease, background 0.35s ease;
  }
  .ddot.is-active {
    width: 26px;
    background: var(--color-gold);
  }

  /* Moulded pockets: ink tabs joined to the image with a concave fillet. */
  .pocket-cta { background: var(--color-ink); border-top-right-radius: 1.5rem; padding: 0.9rem 1.4rem 0 0; }
  .pocket-dots { background: var(--color-ink); border-top-left-radius: 1.5rem; padding: 0.9rem 1.4rem 0.9rem 1.4rem; }

  .fx {
    --r: 22px;
    position: absolute;
    width: var(--r);
    height: var(--r);
    pointer-events: none;
  }
  .fx-tl { background: radial-gradient(circle var(--r) at top left, transparent calc(var(--r) - 0.5px), var(--color-ink) var(--r)); }
  .fx-br { background: radial-gradient(circle var(--r) at bottom right, transparent calc(var(--r) - 0.5px), var(--color-ink) var(--r)); }
  .fx-cta-right { top: calc(-1 * var(--r)); right: 0; }
  .fx-dots-left { top: 0; left: calc(-1 * var(--r)); }

  @media (prefers-reduced-motion: reduce) {
    .dslide.is-active { animation: none; }
  }
</style>

<script>
  const root = document.getElementById('hero-slider');
  const dotsWrap = document.getElementById('hero-dots');
  if (root && dotsWrap) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.dslide'));
    const dots = Array.from(dotsWrap.querySelectorAll<HTMLElement>('.ddot'));
    let index = 0;
    let timer = 0;

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === index));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === index));
    };
    const start = () => { timer = window.setInterval(() => show(index + 1), 5000); };
    const reset = () => { window.clearInterval(timer); start(); };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.i));
        reset();
      }),
    );
    start();
  }
</script>
