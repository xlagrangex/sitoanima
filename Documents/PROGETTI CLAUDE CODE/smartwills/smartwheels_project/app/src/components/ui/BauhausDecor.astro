---
/**
 * BauhausDecor — subtle geometric accents that echo the hero mosaic.
 * Use inside a `relative overflow-hidden` container.
 */
interface Props {
  type?:
    | 'orb'
    | 'disc'
    | 'petal-tl'
    | 'petal-tr'
    | 'petal-bl'
    | 'petal-br'
    | 'petal-tl-sm'
    | 'petal-tr-sm'
    | 'petal-bl-sm'
    | 'petal-br-sm'
    | 'pattern';
  color?: 'gold' | 'gold-dark' | 'cream' | 'ink' | 'line';
  size?: string; // Tailwind size class, e.g. 'size-72' or 'w-40 h-60'
  opacity?: number; // 0–1
  class?: string;
  blur?: boolean | string;
  animate?: boolean;
}

const {
  type = 'orb',
  color = 'gold',
  size = 'size-72',
  opacity = type === 'pattern' ? 0.05 : 0.12,
  class: className = '',
  blur = type === 'orb' || type === 'disc',
  animate = false,
} = Astro.props;

const colorClass: Record<string, string> = {
  gold: 'bg-gold',
  'gold-dark': 'bg-gold-dark',
  cream: 'bg-cream-deep',
  ink: 'bg-ink',
  line: 'bg-line',
};

const blurClass = blur === true ? 'blur-3xl' : blur === false ? '' : String(blur);
const animateClass = animate ? 'animate-float-slow' : '';

const isPattern = type === 'pattern';
const isRound = type === 'orb' || type === 'disc';
const shapeClass = isPattern
  ? ''
  : isRound
    ? `rounded-full ${colorClass[color]}`
    : `${type} ${colorClass[color]}`;
---

{
  isPattern ? (
    <div
      class={`pointer-events-none absolute inset-0 ${className}`}
      style={{
        opacity,
        backgroundImage: 'url(/images/bauhaus-pattern.svg)',
        backgroundSize: '260px 260px',
      }}
      aria-hidden="true"
    />
  ) : (
    <div
      class={`pointer-events-none absolute ${size} ${shapeClass} ${blurClass} ${animateClass} ${className}`}
      style={{ opacity }}
      aria-hidden="true"
    />
  )
}
