---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<a href="/" class="font-heading text-[1.55rem] leading-none font-semibold tracking-tight select-none">
  <span class={dark ? 'text-cream' : 'text-ink'}>Smart</span><span class="text-gold">Wills</span><span class={dark ? 'text-cream' : 'text-ink'}>.ae</span>
</a>
