---
const pageLinks = [
  { label: "Home", href: "/" },
  { label: "Service", href: "/services/business-consulting" },
  { label: "About Us", href: "/about-us" },
  { label: "Case Study", href: "/case-studies" },
  { label: "Contact", href: "/contact" },
  { label: "404", href: "/404" },
];
const socialLinks = [
  { label: "Instagram", href: "https://Instagram.com" },
  { label: "Linkedin", href: "https://Linkedin.com" },
  { label: "Twitter", href: "https://twitter.com" },
  { label: "Facebook", href: "https://facebook.com" },
];
---

<footer class="overflow-hidden bg-cream" data-footer-parallax>
  <div class="container-page px-4 pb-0 pt-24 md:px-0" data-footer-inner>
    <div class="flex flex-col justify-between gap-12 md:flex-row">
      <div class="flex flex-col gap-4">
        <span class="text-[18px] font-medium">Email Us</span>
        <a href="mailto:someone@yoursite.com" class="t-h3">Hello@flexio.co</a>
        <p class="t-body-sm mt-6 opacity-80">
          © 2024&nbsp; Design &amp; Developed <a href="https://x.com/hello_amani" class="underline">Amani</a>
        </p>
        <a href="/privacy-policy" class="t-body-sm underline opacity-80">Privacy Policy</a>
      </div>

      <div class="flex flex-wrap gap-16">
        <div class="flex flex-col gap-3">
          <span class="text-[18px] font-medium opacity-60">Page</span>
          {pageLinks.map((l) => <a href={l.href} class="t-body-sm hover:text-primary">{l.label}</a>)}
        </div>
        <div class="flex flex-col gap-3">
          <span class="text-[18px] font-medium opacity-60">Social</span>
          {socialLinks.map((l) => <a href={l.href} target="_blank" rel="noopener" class="t-body-sm hover:text-primary">{l.label}</a>)}
        </div>
        <div class="flex max-w-[220px] flex-col gap-3">
          <span class="text-[18px] font-medium opacity-60">Studio</span>
          <p class="t-body-sm">201M Suite, N Broad St 651, Middletown, Delaware, USA</p>
        </div>
      </div>
    </div>

    <div class="mt-16 select-none pb-10" aria-hidden="true">
      <img src="/images/logo-ip.png" alt="" class="w-full max-w-[900px]" loading="lazy" />
    </div>
  </div>
</footer>
