---
import Logo from "./Logo.astro";
import Button from "./ui/Button.astro";

const services = [
  { title: "Business Consulting", href: "/services/business-consulting", img: "/images/R8gxZoLunVxfFAUNkxMZhYBWg.png" },
  { title: "Growth Strategy", href: "/services/growth-strategy", img: "/images/b9ELbfDT5kcphXutNcyv2CLCDSQ.png" },
  { title: "Marketing Strategy", href: "/services/marketing-strategy", img: "/images/DSM43FoamJ3WOY4EAFxMEVGeKTY.png" },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 md:px-6 md:pt-5">
  <div class="nav-appear relative mx-auto max-w-[1280px] rounded-[32px] bg-peach py-1.5 pl-6 pr-1.5">
    <div class="flex items-center gap-12">
      <Logo />

      <nav class="hidden items-center gap-8 md:flex">
        <div class="nav-dropdown relative">
          <button class="nav-dropdown-trigger flex items-center gap-1.5 text-[16px] font-medium transition-colors duration-200" aria-haspopup="true">
            Services
            <svg class="nav-dropdown-caret transition-transform duration-300" width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-dropdown-panel absolute left-0 top-[calc(100%+2px)] z-50 pt-5">
            <div class="flex gap-4 rounded-[20px] bg-peach p-4 shadow-xl">
              {services.map((s) => (
                <a href={s.href} class="group relative block h-[clamp(110px,11vw,150px)] w-[clamp(160px,16vw,215px)] overflow-hidden rounded-[14px]">
                  <img src={s.img} alt={s.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/10"></div>
                  <span class="absolute bottom-3 left-3 right-3 text-[16px] font-medium text-white">{s.title}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
        <a href="/about-us" class="text-[16px] font-medium">About Us</a>
        <a href="/case-studies" class="text-[16px] font-medium">Case Studies</a>
      </nav>

      <div class="ml-auto hidden md:block">
        <Button href="/contact" variant="primary">Let's Talk</Button>
      </div>

      <button id="nav-toggle" class="ml-auto flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden" aria-label="Open menu" aria-expanded="false">
        <span class="block h-[2px] w-6 bg-ink transition-transform"></span>
        <span class="block h-[2px] w-6 bg-ink transition-transform"></span>
      </button>
    </div>

    <div id="nav-mobile" class="hidden flex-col gap-4 pb-4 pt-6 md:!hidden">
      <a href="/" class="text-[18px] font-medium">Home</a>
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 text-[18px] font-medium">
          Service
          <svg width="12" height="8" viewBox="0 0 12 8" fill="none" class="transition-transform group-open:rotate-180"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </summary>
        <div class="mt-3 flex flex-col gap-3">
          {services.map((s) => (
            <a href={s.href} class="relative block h-[120px] overflow-hidden rounded-[14px]">
              <img src={s.img} alt={s.title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/10"></div>
              <span class="absolute bottom-3 left-3 text-[16px] font-medium text-white">{s.title}</span>
            </a>
          ))}
        </div>
      </details>
      <a href="/about-us" class="text-[18px] font-medium">About Us</a>
      <a href="/case-studies" class="text-[18px] font-medium">Case Study</a>
      <a href="/contact" class="text-[18px] font-medium">Contact</a>
      <Button href="/contact" variant="primary" class="w-full">Let's Talk</Button>
    </div>
  </div>
</header>

<style>
  /* Mega menu: ancorato sotto "Services", fade + slide morbido (niente display toggle) */
  .nav-dropdown-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.3s;
  }
  @media (min-width: 810px) {
    .nav-dropdown:hover .nav-dropdown-panel,
    .nav-dropdown:focus-within .nav-dropdown-panel {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
      transition:
        opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s;
    }
    .nav-dropdown:hover .nav-dropdown-trigger,
    .nav-dropdown:focus-within .nav-dropdown-trigger {
      color: var(--color-primary);
    }
    .nav-dropdown:hover .nav-dropdown-caret,
    .nav-dropdown:focus-within .nav-dropdown-caret {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  const init = () => {
    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("nav-mobile");
    if (!toggle || !panel || toggle.dataset.init === "1") return;
    toggle.dataset.init = "1";
    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      panel.classList.toggle("flex", open);
      toggle.setAttribute("aria-expanded", String(open));
      const [a, b] = toggle.querySelectorAll("span");
      a.style.transform = open ? "translateY(4px) rotate(45deg)" : "";
      b.style.transform = open ? "translateY(-4px) rotate(-45deg)" : "";
    });
  };
  init();
  document.addEventListener("astro:page-load", init);
</script>
