---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Counter from "../components/react/Counter";
import PhysicsTags from "../components/react/PhysicsTags";
import servicesData from "../data/services.json";
import caseStudiesData from "../data/case-studies.json";

const localImg = (url: string) => `/images/${url.split("/").pop()}`;

const services = servicesData.map((s) => ({
  ...s,
  image: localImg(s.image),
}));

const caseStudies = ["driving-impact-a-healthcare-platform-s-rebuild", "optimizing-conversions-a-tech-startup-s-leap"]
  .map((slug) => caseStudiesData.find((c) => c.slug === slug)!)
  .map((c) => ({ ...c, image: localImg(c.image) }));

const heroImages = [
  { src: "/images/Xup44lT05fI7ULikDpDUcdet5M.png", alt: "Man and woman discussing project" },
  { src: "/images/3TWrH1LgWz28bycoINqeqegsxw4.png", alt: "Man and woman discussing books" },
  { src: "/images/eWSFN4vEE5WYVdCDBVEtEV2oX0.png", alt: "African man smiling on phone" },
  { src: "/images/muPZCrML4kWDHgdZz284LoRPNY.png", alt: "Girl smiling with coffee mug" },
  { src: "/images/GADo4cDx3P81nDG7pb7yA6hjkzw.png", alt: "Man browsing on tablet" },
];

const problemFeatures = [
  { lead: "Inefficient Processes –", text: "Wasting valuable time and resources." },
  { lead: "Inconsistent Growth –", text: "Struggling to reach new milestones." },
  { lead: "Limited Support –", text: "Wasting valuable time and resources." },
];

const processSteps = [
  { title: "Discovery & Strategy", text: "We start by understanding your goals and creating a clear, actionable plan tailored to your needs." },
  { title: "Design & Planning", text: "We develop a detailed roadmap to ensure smooth, efficient execution at every stage." },
  { title: "Implementation", text: "Our team brings the plan to life, focusing on precision and alignment with your vision." },
  { title: "Optimization & Growth", text: "We track outcomes, refine strategies and support ongoing growth for lasting impact." },
];

const physicsTags = [
  { label: "Startup", bg: "#3861F9", color: "#FFFFFF" },
  { label: "Marketing Agency", bg: "#6248B0", color: "#FFFFFF" },
  { label: "Small Business", bg: "#76C6B3", color: "#232030" },
  { label: "Tech Company", bg: "#FFD37D", color: "#232030" },
  { label: "Corporate", bg: "#3758D3", color: "#FFFFFF" },
  { label: "Nonprofit", bg: "#F5B8D9", color: "#232030" },
  { label: "E-commerce Store", bg: "#70A2E1", color: "#232030" },
  { label: "Consulting Firm", bg: "#B3A1E6", color: "#232030" },
];

/* Static variant: "Entrepreneur" replaces "Marketing Agency" */
const staticTags = [
  { label: "Startup", bg: "bg-tag-blue", color: "text-white" },
  { label: "Small Business", bg: "bg-tag-teal", color: "text-ink" },
  { label: "Entrepreneur", bg: "bg-primary", color: "text-white" },
  { label: "Tech Company", bg: "bg-tag-yellow", color: "text-ink" },
  { label: "Corporate", bg: "bg-tag-darkblue", color: "text-white" },
  { label: "Nonprofit", bg: "bg-tag-pink", color: "text-ink" },
  { label: "E-commerce Store", bg: "bg-tag-lightblue", color: "text-ink" },
  { label: "Consulting Firm", bg: "bg-tag-lightprimary", color: "text-ink" },
];

const testimonials = [
  {
    quote: "Their professionalism and insight were unparalleled. They provided us with a solution that not only solved our challenges but elevated our vision beyond what we imagined.",
    author: "– Emma C., Nonprofit Director",
    image: "/images/P0TLTuFqzStOtgDppzxqwrSaEVc.png",
  },
  {
    quote: "The team's expertise turned our vague ideas into a comprehensive strategy. The project exceeded expectations, showcasing their commitment to excellence and innovation.",
    author: "– John M., Tech Lead",
    image: "/images/j0jUAy0zXi2FNhuEc2HKNw4MhfU.png",
  },
  {
    quote: "Working with them was a game-changer for our agency. They delivered innovative solutions tailored to our needs, resulting in noticeable growth and a stronger online presence.",
    author: "– Sophia L., Agency Owner",
    image: "/images/8Qamiprljd6whc05RWjpupi8fY.png",
  },
  {
    quote: "Their creativity and dedication were evident from day one. The final design not only looked stunning but also aligned perfectly with our brand values. A fantastic experience from start to finish!",
    author: "– Alex T., Startup Founder",
    image: "/images/Es96vC5U35Q8bITPI8n4QUuyw2k.png",
  },
];
---

<Layout
  title="Flexio"
  description="Flexio is a sleek Framer template for service-based businesses. Ideal for marketing agencies, business consultants, growth experts..."
>
  <!-- 4.1 Hero -->
  <section class="overflow-hidden bg-primary p-0">
    <div class="curtain-panel bg-cream pb-16 pt-[144px] md:pb-[100px] md:pt-40 lg:pb-[120px] lg:pt-[180px]">
      <div class="container-page px-4 md:px-10 lg:px-[30px]">
        <div class="flex flex-col items-center gap-6 text-center md:items-start md:gap-8 md:text-left">
          <Eyebrow>business &amp; solution</Eyebrow>
          <h1 class="t-h1 max-w-[800px]">Flexible Solutions for Modern Business</h1>
          <p class="t-body max-w-[700px]">
            Delivering bespoke, outcome-focused solutions that enhance workflows, augment productivity and expedite
            corporate expansion.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4 md:justify-start">
            <Button href="/contact" variant="primary">Let's Talk</Button>
            <Button href="/about-us" variant="secondary">Learn More</Button>
          </div>
        </div>
      </div>

      <div class="marquee mt-10 md:mt-[60px] lg:mt-20" data-marquee-speed="40" data-marquee-hover="0.7" data-marquee-scroll>
        <div class="marquee-track gap-2.5">
          {heroImages.map((img) => (
            <img
              src={img.src}
              alt={img.alt}
              class="h-[375px] w-auto max-w-none shrink-0 rounded-[20px] object-cover lg:h-[533px]"
              loading="eager"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4.2 Logo ticker -->
  <section class="bg-primary px-4 py-16 md:px-10 md:py-[60px] lg:px-[30px] lg:py-20">
    <div class="container-page flex flex-col items-center gap-6 text-center">
      <Eyebrow variant="light">Our client's</Eyebrow>
      <h3 class="t-h3 max-w-[680px] text-white">Trusted by High-Growth Startups Across Industries</h3>
    </div>
    <div class="marquee mt-12" data-marquee-speed="30">
      <div class="marquee-track gap-[60px]">
        <!-- 6 placeholder white logomarks, divider between each -->
        <svg class="shrink-0" width="140" height="36" viewBox="0 0 140 36" fill="#FFFFFF" xmlns="http://www.w3.org/2000/svg" aria-label="Client logo placeholder">
          <circle cx="18" cy="18" r="14" />
          <rect x="44" y="12" width="64" height="5" rx="2.5" />
          <rect x="44" y="22" width="40" height="5" rx="2.5" />
        </svg>
        <div class="h-10 w-px shrink-0 bg-white/30"></div>
        <svg class="shrink-0" width="140" height="36" viewBox="0 0 140 36" fill="#FFFFFF" xmlns="http://www.w3.org/2000/svg" aria-label="Client logo placeholder">
          <path d="M4 32 L18 4 L32 32 Z" />
          <rect x="44" y="14" width="80" height="8" rx="4" />
        </svg>
        <div class="h-10 w-px shrink-0 bg-white/30"></div>
        <svg class="shrink-0" width="140" height="36" viewBox="0 0 140 36" fill="#FFFFFF" xmlns="http://www.w3.org/2000/svg" aria-label="Client logo placeholder">
          <rect x="2" y="2" width="32" height="32" rx="8" />
          <circle cx="56" cy="18" r="8" />
          <circle cx="78" cy="18" r="8" />
          <circle cx="100" cy="18" r="8" />
        </svg>
        <div class="h-10 w-px shrink-0 bg-white/30"></div>
        <svg class="shrink-0" width="140" height="36" viewBox="0 0 140 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Client logo placeholder">
          <circle cx="18" cy="18" r="13" stroke="#FFFFFF" stroke-width="6" />
          <rect x="44" y="10" width="72" height="6" rx="3" fill="#FFFFFF" />
          <rect x="44" y="21" width="52" height="6" rx="3" fill="#FFFFFF" />
        </svg>
        <div class="h-10 w-px shrink-0 bg-white/30"></div>
        <svg class="shrink-0" width="140" height="36" viewBox="0 0 140 36" fill="#FFFFFF" xmlns="http://www.w3.org/2000/svg" aria-label="Client logo placeholder">
          <path d="M18 2 L33 11 V25 L18 34 L3 25 V11 Z" />
          <rect x="44" y="14" width="90" height="8" rx="4" />
        </svg>
        <div class="h-10 w-px shrink-0 bg-white/30"></div>
        <svg class="shrink-0" width="140" height="36" viewBox="0 0 140 36" fill="#FFFFFF" xmlns="http://www.w3.org/2000/svg" aria-label="Client logo placeholder">
          <path d="M2 18 A16 16 0 0 1 34 18 Z" />
          <path d="M34 18 A16 16 0 0 1 2 18 Z" transform="translate(0 0)" opacity="0.6" />
          <rect x="44" y="12" width="56" height="5" rx="2.5" />
          <rect x="44" y="22" width="76" height="5" rx="2.5" />
        </svg>
        <div class="h-10 w-px shrink-0 bg-white/30"></div>
      </div>
    </div>
  </section>

  <!-- 4.3 Problem -->
  <section class="bg-cream px-4 pt-16 md:px-10 md:pt-[100px] lg:px-[30px] lg:pt-[140px]">
    <div class="container-page grid grid-cols-1 items-center gap-12 md:grid-cols-2 lg:gap-20">
      <div class="flex flex-col items-start gap-6">
        <Eyebrow>Facing Challenges</Eyebrow>
        <h2 class="t-h2">Overcoming These Key Barriers Starts Here Today</h2>
        <p class="t-body">
          Identify the barriers that prevent your business from reaching its full potential. Addressing these issues
          can transform your path to success.
        </p>
        <ul class="mt-2 flex list-none flex-col gap-5 p-0">
          {problemFeatures.map((f) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 1.5l2.4 2 3.1-.4 1.2 2.9 2.9 1.2-.4 3.1 2 2.4-2 2.4.4 3.1-2.9 1.2-1.2 2.9-3.1-.4-2.4 2-2.4-2-3.1.4-1.2-2.9-2.9-1.2.4-3.1-2-2.4 2-2.4-.4-3.1 2.9-1.2 1.2-2.9 3.1.4z" fill="#6248B0" />
                <path d="M8.5 12.2l2.4 2.4 4.6-4.8" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="t-body"><strong class="font-medium">{f.lead}</strong> {f.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <div class="overflow-hidden rounded-[24px]">
          <img
            data-scale-in
            src="/images/sUrLpU40X4baNonFR9IhFAxsYk8.png"
            alt="Girl using laptop and drinking coffee"
            class="h-auto w-full object-cover"
            loading="lazy"
          />
        </div>
        <img
          src="/images/WfQGykkqhhzNFSv5xGnuq4m0P8Q.png"
          alt="Tag of problem statement"
          class="absolute -left-6 top-[55%] w-[120px] md:-left-10 md:w-[177px]"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 4.4 Solution / Services -->
  <section class="bg-cream px-4 pt-16 md:px-10 md:pt-[100px] lg:px-[30px] lg:pt-[140px]">
    <div class="container-page flex flex-col items-center gap-6 text-center">
      <Eyebrow>our service</Eyebrow>
      <h2 class="t-h2 max-w-[700px]">Our Expert Services to Drive Growth</h2>
    </div>
    <div class="container-page mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {services.map((s) => (
        <a
          href={`/services/${s.slug}`}
          class="group relative block aspect-[4/5] overflow-hidden rounded-[20px] md:aspect-[3/4]"
        >
          <img src={s.image} alt={s.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-x-0 top-0 h-2/5 bg-gradient-to-b from-black/55 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/40 to-transparent"></div>
          <div class="absolute inset-0 bg-black/0 transition-colors duration-500 group-hover:bg-black/30"></div>
          <div class="absolute inset-x-0 top-0 flex flex-col gap-3 p-6">
            <div class="flex items-start justify-between gap-4">
              <h4 class="t-h4 text-white">{s.title}</h4>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/25 backdrop-blur-sm transition-transform duration-500 group-hover:rotate-45" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 1v14M1 8h14" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            </div>
            <p class="t-body max-w-[90%] -translate-y-3 text-white opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
              {s.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4.5 Process -->
  <section class="bg-cream px-4 py-16 md:px-10 md:py-[100px] lg:px-[30px] lg:py-[140px]">
    <div class="container-page grid grid-cols-1 gap-12 md:grid-cols-2 lg:gap-20">
      <div class="flex flex-col items-start gap-6 self-start md:sticky md:top-32">
        <Eyebrow>Our Approach</Eyebrow>
        <h2 class="t-h2">A Streamlined Process for Lasting Results</h2>
        <div class="mt-2 flex flex-wrap items-center gap-4">
          <Button href="/contact" variant="primary">Let's Talk</Button>
          <Button href="/about-us" variant="secondary">Learn More</Button>
        </div>
      </div>
      <div class="flex flex-col">
        {processSteps.map((step, i) => (
          <div class={`flex items-start gap-5 py-8 ${i < processSteps.length - 1 ? "border-b border-ink/10" : ""} ${i === 0 ? "pt-0" : ""}`}>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-lg font-medium text-white">
              {i + 1}
            </span>
            <div class="flex flex-col gap-2">
              <h4 class="t-h4">{step.title}</h4>
              <p class="t-body">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.6 Video (scroll-pinned) -->
  <section data-video-section class="relative z-[1] h-screen lg:h-[2280px]">
    <div class="sticky top-0 h-screen w-full overflow-hidden">
      <video
        data-video-scale
        src="/videos/dcvnnvkeNKmgN1qxCAM2MNUiZM.mp4"
        class="absolute inset-0 h-full w-full object-cover"
        autoplay
        loop
        muted
        playsinline
      ></video>
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="absolute inset-0 flex items-center justify-center px-6">
        <h2
          data-video-headline
          class="t-h2 absolute max-w-[900px] text-center text-white transition-all duration-700 ease-out"
          style="opacity: 1; transform: translateY(0);"
        >
          Expert advice to streamline operations and accelerate growth.
        </h2>
        <h2
          data-video-headline
          class="t-h2 absolute max-w-[900px] text-center text-white transition-all duration-700 ease-out"
          style="opacity: 0; transform: translateY(20px);"
        >
          Tailored to your brand's needs &amp; designed to enhance your business
        </h2>
      </div>
    </div>
    <div data-video-trigger="0" class="pointer-events-none absolute left-0 top-[20%] h-[20%] w-full" aria-hidden="true"></div>
    <div data-video-trigger="1" class="pointer-events-none absolute left-0 top-[60%] h-[20%] w-full" aria-hidden="true"></div>
  </section>

  <!-- "Body" wrapper sliding over the pinned video -->
  <div class="relative z-[2] bg-cream">
    <div class="radius-top"></div>

    <!-- 4.7 Numbers / Stats -->
    <section class="bg-cream px-4 pb-16 pt-11 md:px-10 md:pb-[100px] md:pt-[60px] lg:px-[30px] lg:pb-[140px] lg:pt-[100px]">
      <div class="container-page flex flex-col items-center gap-6 text-center">
        <Eyebrow>Who we are</Eyebrow>
        <h2 class="t-h2 max-w-[760px]">Transforming Businesses with Expertise</h2>
      </div>
      <div class="container-page mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="flex min-h-[194px] flex-col items-center justify-center gap-1 rounded-[16px] bg-primary p-8 text-center text-cream">
          <span class="text-[60px] font-medium leading-none"><Counter client:visible start={0} end={3} suffix="+" /></span>
          <span class="t-h4">Years</span>
          <p class="t-body-sm">Proven Experience</p>
        </div>
        <div class="flex min-h-[194px] flex-col items-center justify-center gap-1 rounded-[16px] bg-primary p-8 text-center text-cream">
          <span class="text-[60px] font-medium leading-none"><Counter client:visible start={0} end={20} suffix="+" /></span>
          <span class="t-h4">Clients</span>
          <p class="t-body-sm">Trusted Partnerships</p>
        </div>
        <div class="flex min-h-[194px] flex-col items-center justify-center gap-1 rounded-[16px] bg-primary p-8 text-center text-cream">
          <span class="text-[60px] font-medium leading-none"><Counter client:visible start={30} end={50} suffix="+" /></span>
          <p class="t-body-sm">Project Impactful Results</p>
        </div>
      </div>
    </section>

    <!-- 4.8 Industry tags (physics): lo spazio fisico copre TUTTA la sezione,
         tetto al margine superiore, pill con z-index sopra il titolo -->
    <section class="relative overflow-hidden bg-peach pt-16 md:pt-[100px]">
      <div class="container-page flex flex-col items-center gap-6 px-4 text-center">
        <Eyebrow>Industries We Serve</Eyebrow>
        <h2 class="t-h2 max-w-[820px]">Industry-Specific Expertise to Drive Your Success</h2>
      </div>
      <div class="hidden h-[280px] min-[1200px]:block"></div>
      <div class="absolute inset-0 z-10 hidden min-[1200px]:block">
        <PhysicsTags client:visible tags={physicsTags} height="100%" />
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4 px-4 pb-16 pt-10 min-[1200px]:hidden">
        {staticTags.map((t) => (
          <span class={`rounded-full px-10 py-5 text-[18px] font-medium ${t.bg} ${t.color}`}>{t.label}</span>
        ))}
      </div>
    </section>

    <!-- 4.9 Testimonials -->
    <section class="bg-cream pt-16 md:pt-[100px] lg:pt-[140px]">
      <div class="container-page flex flex-col items-center gap-6 px-4 text-center md:px-10 lg:px-[30px]">
        <Eyebrow>Our client's</Eyebrow>
        <h2 class="t-h2 max-w-[700px]">Relied on by Companies Globally</h2>
      </div>
      <div class="marquee mt-12" data-marquee-speed="40" data-marquee-hover="0.2">
        <div class="marquee-track gap-6">
          {testimonials.map((t) => (
            <div class="flex h-[420px] w-[320px] shrink-0 flex-col gap-5 rounded-[24px] bg-primary p-6 md:h-[280px] md:w-[680px] md:flex-row md:gap-8 md:p-8">
              <div class="flex flex-1 flex-col justify-between gap-4">
                <div class="flex flex-col gap-4">
                  <svg width="44" height="34" viewBox="0 0 60 46" fill="#FBFAFE" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M0 46V27.6C0 12.4 8.8 2.8 24 0l3.2 7.2C17.6 10 12.8 15.2 12 22h12v24H0zm33 0V27.6C33 12.4 41.8 2.8 57 0l3 7.2C50.6 10 45.8 15.2 45 22h12v24H33z" />
                  </svg>
                  <p class="t-body-sm text-cream md:text-[17px] md:leading-[26px]">{t.quote}</p>
                </div>
                <p class="font-medium text-cream">{t.author}</p>
              </div>
              <img src={t.image} alt={t.author} class="h-[140px] w-full shrink-0 rounded-[16px] object-cover md:h-full md:w-[185px]" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4.10 Case Study -->
    <section class="bg-cream px-4 py-16 md:px-10 md:py-[100px] lg:px-[30px] lg:py-[140px]">
      <div class="container-page flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col items-start gap-6">
          <Eyebrow>case study</Eyebrow>
          <h2 class="t-h2 max-w-[640px]">Client Success Through Our Solutions</h2>
        </div>
        <div class="hidden md:block">
          <Button href="/case-studies" variant="secondary">Explore All</Button>
        </div>
      </div>
      <div class="container-page mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        {caseStudies.map((c) => (
          <a href={`/case-studies/${c.slug}`} class="group flex flex-col gap-6">
            <div class="overflow-hidden rounded-[20px]">
              <img src={c.image} alt={c.title} class="h-auto w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="flex flex-col items-start gap-4">
              <Eyebrow>{c.tag}</Eyebrow>
              <h4 class="t-h4">{c.title}</h4>
            </div>
          </a>
        ))}
      </div>
      <div class="container-page mt-10 md:hidden">
        <Button href="/case-studies" variant="secondary">Explore All</Button>
      </div>
    </section>

    <!-- 4.11 CTA banner -->
    <CtaBanner />
  </div>
</Layout>
