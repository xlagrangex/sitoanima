---
import Layout from "../../layouts/Layout.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import CaseCard from "../../components/sections/case-studies/CaseCard.astro";
import caseStudies from "../../data/case-studies.json";

// Ordine di display della list page (diverso dall'ordine collection del JSON)
const displayOrder = [
  "driving-impact-a-healthcare-platform-s-rebuild",
  "optimizing-conversions-a-tech-startup-s-leap",
  "scaling-success-a-nonprofit-s-digital-growth",
  "innovating-spaces-real-estate-website-revamp",
];
const cards = displayOrder.map((slug) => caseStudies.find((c) => c.slug === slug)!);
const rows = [cards.slice(0, 2), cards.slice(2, 4)];
---

<Layout
  title="Flexio"
  description="Flexio is a sleek Framer template for service-based businesses. Ideal for marketing agencies, business consultants, growth strategies, digital solutions and service providers."
>
  <section class="overflow-hidden bg-primary">
    <div class="curtain-panel w-full bg-cream px-4 pb-16 pt-[144px] md:px-10 md:pb-[100px] md:pt-40 lg:px-[30px] lg:pb-[140px] lg:pt-[180px]">
      <div class="mx-auto flex w-full max-w-[500px] flex-col items-center gap-10 md:max-w-[1140px]">
        <div class="flex flex-col items-center gap-3">
          <Eyebrow>case study</Eyebrow>
          <h2 class="t-h2 max-w-[700px] text-center md:max-w-[800px]">Our Solutions Drive Success for Clients</h2>
        </div>

        <div class="flex w-full flex-col gap-10">
          {rows.map((row) => (
            <div class="flex w-full flex-col gap-[30px] md:flex-row md:gap-6">
              {row.map((cs) => (
                <CaseCard slug={cs.slug} title={cs.title} tag={cs.tag} image={cs.image} />
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
