---
import Layout from "../../layouts/Layout.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import CaseCard from "../../components/sections/case-studies/CaseCard.astro";
import caseStudies from "../../data/case-studies.json";

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

interface Props {
  cs: (typeof caseStudies)[number];
}

const { cs } = Astro.props;

const local = (url: string) => `/images/${url.split("/").pop()}`;

// Regola related verificata: prime 2 voci dell'ordine collection (JSON) escludendo la corrente
const related = caseStudies.filter((c) => c.slug !== cs.slug).slice(0, 2);

const inlineAlts: Record<string, string> = {
  "driving-impact-a-healthcare-platform-s-rebuild": "People using laptop and discusing",
};
const inlineAlt = inlineAlts[cs.slug] ?? "People using laptop and discusing";

const shareLinks = [
  { href: "https://facebook.com", label: "Facebook" },
  { href: "https://twitter.com", label: "Twitter" },
  { href: "https://Linkedin.com", label: "LinkedIn" },
  { href: "https://instagram.com", label: "Instagram" },
];
---

<Layout title={`${cs.title} - Flexio`} description={cs.description}>
  <div class="relative overflow-hidden bg-orange">
    <div id="hero" class="absolute left-0 top-0 h-px w-px" aria-hidden="true"></div>

    <section class="curtain-panel w-full bg-cream px-4 pb-16 pt-[144px] md:px-10 md:pb-[100px] md:pt-40 lg:px-[30px] lg:pb-[140px] lg:pt-[180px]">
      <div class="mx-auto flex w-full max-w-[500px] flex-col gap-16 md:max-w-[1140px] md:gap-20 lg:gap-[100px]">
        <!-- A. Hero block -->
        <div class="flex flex-col gap-10 overflow-hidden">
          <div class="flex flex-col items-center gap-6">
            <div class="flex flex-col items-center gap-3">
              <Eyebrow>{cs.tag}</Eyebrow>
              <h2 class="t-h2 max-w-[700px] text-center">{cs.title}</h2>
            </div>
            <p class="max-w-[600px] text-center text-[16px] font-medium leading-[26px] md:text-[18px] md:leading-[28px]">
              {cs.description}
            </p>
          </div>

          <div class="aspect-[2.07273] w-full overflow-hidden rounded-[16px] bg-peach md:rounded-[20px] lg:rounded-[24px]">
            <div data-scale-in class="h-full w-full">
              <img src={local(cs.image)} alt={cs.title} class="h-full w-full object-cover" />
            </div>
          </div>
        </div>

        <!-- B. Blog container: article + sticky meta sidebar -->
        <div class="flex flex-col gap-[60px] md:flex-row md:gap-10 lg:gap-[100px]">
          <article class="flex min-w-0 flex-col gap-10 md:flex-[2]">
            <div class="rich" set:html={cs.mainContentHtml} />

            <blockquote class="m-0 w-full rounded-[8px] bg-quote p-6 text-center">
              <p class="text-[16px] font-medium leading-[26px] md:text-[18px] md:leading-[28px]">
                "Effective marketing is not just about reaching people—it's about connecting with them in meaningful ways."
              </p>
            </blockquote>

            <div class="aspect-[1.71391] w-full overflow-hidden rounded-[16px] md:rounded-[20px]">
              <div data-scale-in class="h-full w-full">
                <img src={local(cs.inlineImage)} alt={inlineAlt} loading="lazy" class="h-full w-full object-cover" />
              </div>
            </div>

            <div class="rich" set:html={cs.subContentHtml} />
          </article>

          <aside class="z-[1] flex w-full flex-col gap-10 self-start rounded-[16px] bg-quote p-[30px] md:sticky md:top-[60px] md:flex-1">
            <div class="flex flex-col gap-2">
              <p class="text-[16px] font-medium leading-[26px] md:text-[18px] md:leading-[28px]">Client's Name</p>
              <p class="text-[16px] leading-[26px]">{cs.clientName}</p>
            </div>
            <div class="flex flex-col gap-2">
              <p class="text-[16px] font-medium leading-[26px] md:text-[18px] md:leading-[28px]">Duration</p>
              <p class="text-[16px] leading-[26px]">{cs.duration}</p>
            </div>
            <div class="flex flex-col gap-2">
              <!-- "Sulution": typo verbatim dell'originale, mantenuto di proposito -->
              <p class="text-[16px] font-medium leading-[26px] md:text-[18px] md:leading-[28px]">Sulution</p>
              <p class="text-[16px] leading-[26px]">{cs.solution}</p>
            </div>
            <div class="flex flex-col gap-2">
              <p class="text-[16px] font-medium leading-[26px] md:text-[18px] md:leading-[28px]">Share Case Study</p>
              <div class="flex flex-row gap-2">
                {shareLinks.map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Share on ${s.label}`}
                    class="flex h-10 w-10 items-center justify-center rounded-[99px] bg-white text-ink"
                  >
                    {s.label === "Facebook" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
                      </svg>
                    )}
                    {s.label === "Twitter" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
                      </svg>
                    )}
                    {s.label === "LinkedIn" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
                      </svg>
                    )}
                    {s.label === "Instagram" && (
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.72 3.72 0 0 1-.9 1.38 3.72 3.72 0 0 1-1.38.9c-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.88 5.88 0 0 0-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.48 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84Zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4Zm7.85-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44Z" />
                      </svg>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </aside>
        </div>

        <!-- C. Other Case Study -->
        <div class="flex flex-col gap-8 md:gap-[60px] lg:gap-10">
          <div class="flex flex-col items-center gap-6 md:flex-row md:items-end md:justify-between">
            <h2 class="t-h2 max-w-[700px] text-center md:text-left">Other Case Study</h2>
            <Button href="/case-studies" variant="secondary">Explore All</Button>
          </div>
          <div class="flex w-full flex-col gap-[30px] md:flex-row md:gap-6">
            {related.map((c) => (
              <CaseCard slug={c.slug} title={c.title} tag={c.tag} image={c.image} />
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  <CtaBanner />

  <a
    href="#hero"
    data-back-to-top
    aria-label="Back to top"
    class="fixed bottom-0 right-0 z-40 p-6 md:px-8 md:pb-[68px] md:pt-8"
  >
    <span class="flex h-12 w-12 items-center justify-center rounded-[80px] bg-white text-ink shadow-[0_2px_4px_rgba(0,0,0,0.1)]">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="m5 12 7-7 7 7" />
      </svg>
    </span>
  </a>
</Layout>

<style>
  /* Rich text dei campi CMS (set:html → serve :global) */
  .rich :global(h3) {
    font-size: clamp(36px, 3.7vw, 44px);
    line-height: 1.2;
    font-weight: 500;
    color: var(--color-ink);
  }
  .rich :global(p),
  .rich :global(li) {
    font-size: 16px;
    line-height: 26px;
    font-weight: 400;
    color: var(--color-ink);
  }
  .rich :global(h3 + p) { margin-top: 16px; }
  .rich :global(p + p) { margin-top: 16px; }
  .rich :global(p + h3),
  .rich :global(ul + h3) { margin-top: 40px; }
  .rich :global(ul) {
    margin: 16px 0 0;
    padding-left: 24px;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .rich :global(li p) { margin: 0; }

  /* Back-to-top: nascosto finché non si scrolla */
  [data-back-to-top] {
    opacity: 0;
    transform: translateY(48px);
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  [data-back-to-top].is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  const initBackToTop = () => {
    const btn = document.querySelector<HTMLElement>("[data-back-to-top]:not([data-btt-init])");
    if (!btn) return;
    btn.dataset.bttInit = "1";
    const onScroll = () => {
      btn.classList.toggle("is-visible", window.scrollY > 400);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  };

  initBackToTop();
  document.addEventListener("astro:page-load", initBackToTop);
</script>
