---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Counter from "../components/react/Counter";

const starPoints =
  "70.0,0.0 82.5,15.7 100.4,7.1 104.9,26.8 124.7,26.9 120.5,46.7 138.2,55.6 126.0,71.5 138.2,87.4 120.5,96.3 124.7,116.1 104.9,116.2 100.4,135.9 82.5,127.3 70.0,143.0 57.5,127.3 39.6,135.9 35.1,116.2 15.3,116.1 19.5,96.3 1.8,87.4 14.0,71.5 1.8,55.6 19.5,46.7 15.3,26.9 35.1,26.8 39.6,7.1 57.5,15.7";

const values = [
  {
    title: "Reliability",
    text: "Count on us for dependable, consistent service, ensuring results that build trust at every step.",
    glyph: `<circle cx="70" cy="71.5" r="21" /><polyline points="60 72 67.5 79.5 81 63.5" />`,
  },
  {
    title: "Innovation",
    text: "We craft forward-thinking solutions, keeping your business ahead of evolving challenges.",
    glyph: `<path d="M70 47c-9.4 0-17 7.6-17 17 0 6.3 3.4 11 7 14.5 2 2 3 4 3 6.5h14c0-2.5 1-4.5 3-6.5 3.6-3.5 7-8.2 7-14.5 0-9.4-7.6-17-17-17z" /><line x1="63" y1="91" x2="77" y2="91" /><line x1="65" y1="97" x2="75" y2="97" />`,
  },
  {
    title: "Integrity",
    text: "In every action we undertake, openness and sincerity are paramount, guaranteeing moral delivery.",
    glyph: `<line x1="70" y1="48" x2="70" y2="92" /><line x1="52" y1="56" x2="88" y2="56" /><path d="M52 56 45 72a8 8 0 0 0 14 0z" /><path d="M88 56 81 72a8 8 0 0 0 14 0z" /><line x1="60" y1="94" x2="80" y2="94" />`,
  },
  {
    title: "Security",
    text: "Your data's safety is our top priority, using robust measures to keep it protected.",
    glyph: `<path d="M70 47l-18 7v14c0 12 7.6 20.6 18 24 10.4-3.4 18-12 18-24V54z" /><circle cx="70" cy="67" r="4.5" /><line x1="70" y1="71.5" x2="70" y2="80" />`,
  },
];

const team = [
  {
    name: "Alex Turner",
    role: "CEO & Founder",
    image: "/images/WOTqOFUP4mjdZ8WDBbfwDPWZqLU.png",
    alt: "Man smiling",
  },
  {
    name: "Sophia Lee",
    role: "Chief Marketing Officer",
    image: "/images/CyAZkzNqP6wAbzFd5fOxnqOALk.png",
    alt: "Businesswoman smiling",
  },
  {
    name: "Emma Clark",
    role: "Head of Operations",
    image: "/images/XT0Z2yP6Hg99e8ukbPh9p9xkUk.png",
    alt: "Young woman smiling at someone",
  },
  {
    name: "John Miller",
    role: "Lead Developer",
    image: "/images/JKVDpXkRnYMMJo8USflSIYDiGs.png",
    alt: "African man talking on phone",
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="overflow-hidden bg-primary">
    <div class="curtain-panel bg-cream px-4 pt-[144px] md:px-10 md:pt-[160px] lg:px-[30px] lg:pt-[180px]">
      <div class="container-page flex flex-col gap-14 md:gap-20">
        <div class="flex flex-col items-start gap-8 md:gap-10 lg:gap-[60px]">
          <Eyebrow>About us</Eyebrow>
          <h1 class="t-h1 max-w-[900px]">Everything We Do, Founded on Our Core Values</h1>
          <p class="t-body max-w-[700px]">
            Discover our story, principles, and the fervor that prompts us to provide outstanding
            services for companies akin to yours.
          </p>
        </div>

        <div class="flex flex-col gap-6 md:flex-row">
          <div
            class="hero-media relative flex-[2] overflow-hidden rounded-[24px] bg-peach"
            style="aspect-ratio: 1.4745;"
          >
            <div data-scale-in class="h-full w-full">
              <img
                src="/images/zISQJkl1KYD1zgYs1DCNHiN9IGM.png"
                alt="Professional Work Discussion"
                width="1119"
                height="765"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div
            class="hero-media relative flex-1 overflow-hidden rounded-[24px] bg-peach"
            style="aspect-ratio: 0.7373;"
          >
            <div data-scale-in class="h-full w-full">
              <img
                src="/images/wwPGvpGH4OAoQM7wDWZkvyfazLo.png"
                alt="Group of Young Adults in Smart Casual"
                width="546"
                height="765"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <div class="flex min-h-[194px] flex-col items-start justify-between rounded-[16px] bg-primary p-6 text-cream">
            <span class="text-[48px] font-medium leading-none md:text-[60px]">
              <Counter client:visible start={90} end={100} suffix="%" />
            </span>
            <p class="t-body-sm">Client Satisfaction</p>
          </div>
          <div class="flex min-h-[194px] flex-col items-start justify-between rounded-[16px] bg-primary p-6 text-cream">
            <span class="text-[48px] font-medium leading-none md:text-[60px]">
              <Counter client:visible end={3} suffix="+" />
            </span>
            <p class="t-body-sm">Years on Market</p>
          </div>
          <div class="flex min-h-[194px] flex-col items-start justify-between rounded-[16px] bg-primary p-6 text-cream">
            <span class="text-[48px] font-medium leading-none md:text-[60px]">
              $<Counter client:visible end={4} suffix="m" />
            </span>
            <p class="t-body-sm">in pure Profits</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our story -->
  <section class="bg-cream px-4 py-16 md:px-10 md:py-[100px] lg:px-[30px] lg:py-[140px]">
    <div class="container-page flex flex-col items-start gap-6">
      <div class="flex flex-col items-start gap-3">
        <Eyebrow>Our story</Eyebrow>
        <h2 class="t-h2 max-w-[800px]">Story of Passion, Growth, and Dedication</h2>
      </div>

      <div class="flex flex-col gap-6 md:flex-row md:gap-[30px]">
        <p class="t-body flex-1">
          Our journey started as a humble undertaking with colossal aspirations, evolving into a
          flourishing establishment committed to fortifying businesses. From the outset, our
          mission centered around devising insightful strategies that address actual challenges
          and facilitate our clients' triumph. During our progression, we've welcomed innovation
          and remained unwavering in our principles.
        </p>
        <p class="t-body flex-1">
          We've forged enduring partnerships that motivate us constantly. Our path is ignited by
          enthusiasm, propelled by proficiency, and directed by the conviction that victory is a
          mutual accomplishment. In unison with our clientele, we've converted obstacles into
          possibilities, one endeavor at a time.
        </p>
      </div>

      <blockquote class="w-full rounded-[8px] bg-quote p-6">
        <p class="text-[20px] font-medium leading-[1.3] md:text-[24px]">
          Impressive feats are erected on solid confidence, integrated teamwork, and the unyielding
          quest for superiority which triggers advancement.
        </p>
      </blockquote>
    </div>
  </section>

  <!-- Video (scroll-pinned) -->
  <section data-video-section class="relative h-screen lg:h-[2280px]">
    <div class="sticky top-0 h-screen w-full overflow-hidden">
      <video
        data-video-scale
        src="/videos/dcvnnvkeNKmgN1qxCAM2MNUiZM.mp4"
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 h-full w-full object-cover"
      ></video>
      <div class="absolute inset-0 bg-black/30"></div>
      <div class="relative flex h-full items-center justify-center px-4 md:px-10">
        <h2
          data-video-headline
          class="t-h2 absolute max-w-[900px] text-center text-white transition-[opacity,transform] duration-700 ease-out"
          style="opacity: 1; transform: translateY(0);"
        >
          Expert advice to streamline operations and accelerate growth.
        </h2>
        <h2
          data-video-headline
          class="t-h2 absolute max-w-[900px] text-center text-white transition-[opacity,transform] duration-700 ease-out"
          style="opacity: 0; transform: translateY(20px);"
        >
          Tailored to your brand's needs &amp; designed to enhance your business
        </h2>
      </div>
    </div>
    <div data-video-trigger="0" class="absolute left-0 top-[25%] h-[10px] w-full"></div>
    <div data-video-trigger="1" class="absolute left-0 top-[55%] h-[10px] w-full"></div>
  </section>

  <!-- Body: slides over the pinned video -->
  <div class="relative z-[2]">
    <div class="radius-top"></div>

    <!-- Mission / values -->
    <section class="bg-cream px-4 pt-[34px] pb-16 md:px-10 md:pt-[100px] md:pb-10 lg:px-[30px]">
      <div class="container-page flex flex-col items-center gap-10 md:gap-[60px] lg:gap-10">
        <div class="flex flex-col items-center gap-3 text-center">
          <Eyebrow>our mission</Eyebrow>
          <h2 class="t-h2 max-w-[800px]">Delivering Trust, Reliability, and Excellence</h2>
          <p class="t-body mt-3 max-w-[700px]">
            Our mission is to provide tailored solutions with a focus on transparency,
            dependability, and client satisfaction. We strive to build lasting relationships by
            prioritizing the unique needs of every business we serve.
          </p>
        </div>

        <div class="grid w-full max-w-[800px] grid-cols-1 gap-6 md:grid-cols-2 md:gap-10">
          {
            values.map((value) => (
              <div class="flex flex-col items-center gap-6 text-center">
                <svg
                  width="140"
                  height="143"
                  viewBox="0 0 140 143"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <polygon points={starPoints} fill="#6248B0" />
                  <g
                    stroke="#FFFFFF"
                    stroke-width="2.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={value.glyph}
                  />
                </svg>
                <div class="flex flex-col items-center gap-3">
                  <h4 class="t-h4">{value.title}</h4>
                  <p class="t-body-sm max-w-[340px]">{value.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="bg-cream px-4 py-16 md:px-10 md:py-[100px] lg:px-[30px] lg:py-[140px]">
      <div class="container-page flex flex-col gap-10 md:gap-[60px]">
        <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
          <div class="flex flex-col items-start gap-3">
            <Eyebrow>Meet our team</Eyebrow>
            <h2 class="t-h2">Our Dedicated Team</h2>
          </div>
          <Button href="/contact" class="hidden md:inline-flex">Join Us</Button>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            team.map((member) => (
              <div class="group relative overflow-hidden rounded-[20px]" style="aspect-ratio: 474 / 606;">
                <img
                  src={member.image}
                  alt={member.alt}
                  width="474"
                  height="606"
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover"
                />
                <div class="absolute inset-0 bg-ink/40 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
                <div class="absolute inset-x-3 bottom-3 flex translate-y-[120%] items-center justify-between gap-3 rounded-[12px] bg-cream p-4 opacity-0 transition-[transform,opacity] duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100">
                  <div class="flex flex-col gap-1">
                    <h4 class="text-[20px] font-medium leading-[1.2]">{member.name}</h4>
                    <p class="t-body-sm">{member.role}</p>
                  </div>
                  <div class="flex items-center gap-2">
                    <a
                      href="https://twitter.com"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${member.name} on Twitter`}
                      class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white transition-colors hover:bg-ink"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    </a>
                    <a
                      href="https://Linkedin.com"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${member.name} on LinkedIn`}
                      class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white transition-colors hover:bg-ink"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.31h4.56V23H.22zM8.34 8.31h4.37v2h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.47 3.04 5.47 7v8.06h-4.55v-7.15c0-1.7-.03-3.9-2.38-3.9-2.38 0-2.74 1.86-2.74 3.78V23H8.34z" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <Button href="/contact" class="self-start md:hidden">Join Us</Button>
      </div>
    </section>

    <!-- CTA banner -->
    <CtaBanner />
  </div>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-media {
      animation: hero-media-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
    }
    @keyframes hero-media-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
