---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import CtaBanner from "../components/CtaBanner.astro";

const steps = [
  {
    icon: "envelope",
    title: "Email",
    link: { label: "hello@flexio.com", href: "mailto:someone@yoursite.com" },
  },
  {
    icon: "phone",
    title: "Get support",
    link: { label: "Chat with us", href: "https://slack.com/" },
  },
  {
    icon: "pin",
    title: "Address",
    text: "New York, United State",
  },
] as const;
---

<Layout>
  <section class="curtain-panel bg-cream px-4 pb-16 pt-[144px] md:px-10 md:pb-[100px] md:pt-[160px] lg:px-[30px] lg:pb-[140px] lg:pt-[180px]">
    <div class="mx-auto flex w-full max-w-[500px] flex-col gap-10 overflow-hidden md:max-w-[1140px] md:flex-row md:gap-[30px] lg:gap-[120px]">
      <!-- Left column -->
      <div class="flex flex-1 flex-col gap-8">
        <div><Eyebrow>Contact Us</Eyebrow></div>
        <h2 class="t-h2">Contact Us</h2>
        <p class="text-[18px] leading-[28px]">
          For inquiries or support related to Whelp, please contact us using the form on this page or use the provided email address and phone number to contact us directly.
        </p>

        <div class="flex flex-col gap-5">
          {
            steps.map((step) => (
              <div class="flex items-center gap-4">
                {step.icon === "envelope" && (
                  <svg width="52" height="52" viewBox="0 0 52 52" fill="none" aria-hidden="true" class="shrink-0">
                    <rect width="52" height="52" rx="26" fill="#6248B0" />
                    <rect x="16" y="19" width="20" height="14" rx="2" fill="#fff" fill-opacity="0.2" stroke="#fff" stroke-width="1.5" />
                    <path d="M16.5 20.5 26 27.5l9.5-7" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {step.icon === "phone" && (
                  <svg width="52" height="52" viewBox="0 0 52 52" fill="none" aria-hidden="true" class="shrink-0">
                    <rect width="52" height="52" rx="26" fill="#6248B0" />
                    <path
                      d="M33.9 30.4c-1-.9-2.2-1.5-3.4-1.8-.5-.1-1 0-1.3.4l-1 1.3a13.6 13.6 0 0 1-5.5-5.5l1.3-1c.4-.3.5-.8.4-1.3-.3-1.2-.9-2.4-1.8-3.4-.4-.5-1-.6-1.6-.4l-2.3.8c-.6.2-.9.8-.8 1.4a16.4 16.4 0 0 0 13.9 13.9c.6.1 1.2-.2 1.4-.8l.8-2.3c.2-.5 0-1.2-.4-1.6Z"
                      fill="#fff"
                    />
                    <path d="M27.5 18.5a7 7 0 0 1 6 6" stroke="#fff" stroke-opacity="0.2" stroke-width="2" stroke-linecap="round" />
                  </svg>
                )}
                {step.icon === "pin" && (
                  <svg width="52" height="52" viewBox="0 0 52 52" fill="none" aria-hidden="true" class="shrink-0">
                    <rect width="52" height="52" rx="26" fill="#6248B0" />
                    <path
                      d="M26 16.5c-4.1 0-7.5 3.4-7.5 7.5 0 5.5 7.5 11.5 7.5 11.5s7.5-6 7.5-11.5c0-4.1-3.4-7.5-7.5-7.5Z"
                      fill="#fff"
                      fill-opacity="0.2"
                      stroke="#fff"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <circle cx="26" cy="24" r="2.5" fill="#fff" />
                  </svg>
                )}
                <div class="flex flex-col gap-1">
                  <p class="text-[18px] font-medium leading-[1.3]">{step.title}</p>
                  {"link" in step ? (
                    <a href={step.link.href} class="text-[16px] leading-[26px] underline underline-offset-2">
                      {step.link.label}
                    </a>
                  ) : (
                    <p class="text-[16px] leading-[26px]">{step.text}</p>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right column: form card -->
      <form method="POST" action="#" class="flex flex-1 flex-col gap-5 rounded-[16px] bg-peach p-4 md:p-6">
        <div class="flex flex-col gap-5 md:flex-row md:gap-4">
          <label class="flex flex-1 flex-col gap-2">
            <span class="text-[16px] font-medium text-ink">First Name</span>
            <input type="text" name="first_name" placeholder="First name" class="form-input" />
          </label>
          <label class="flex flex-1 flex-col gap-2">
            <span class="text-[16px] font-medium text-ink">Last Name</span>
            <input type="text" name="last_name" placeholder="Last name" class="form-input" />
          </label>
        </div>
        <label class="flex flex-col gap-2">
          <span class="text-[16px] font-medium text-ink">Email</span>
          <input type="email" name="email" placeholder="Your email" class="form-input" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-[16px] font-medium text-ink">Phone Number</span>
          <input type="tel" name="phone" placeholder="Your phone" class="form-input" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-[16px] font-medium text-ink">Message</span>
          <textarea name="message" placeholder="Write your message" class="form-input h-[140px] resize-none py-3"></textarea>
        </label>
        <div class="flex flex-col gap-3">
          <button type="submit" class="btn btn--primary h-12 w-full">
            <span class="btn-label">Submit</span>
            <span class="btn-label btn-label--ghost" aria-hidden="true">Submit</span>
          </button>
          <p class="text-center text-[14px] leading-[1.6] text-ink">
            By submitting this form you agree to our friendly <a href="/privacy-policy" class="underline underline-offset-2">Privacy Policy</a>
          </p>
        </div>
      </form>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .form-input {
    width: 100%;
    height: 48px;
    padding: 12px;
    background: #fff;
    border: 1px solid transparent;
    border-radius: 8px;
    font-family: var(--font-form);
    font-size: 16px;
    font-weight: 400;
    color: var(--color-ink);
    transition: border-color 0.2s ease;
  }
  .form-input::placeholder {
    color: var(--color-ink);
  }
  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  textarea.form-input {
    height: 140px;
  }
</style>
